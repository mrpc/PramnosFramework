<?php
/**
 * {{ objectName }} detail (read-only) view (plain-CSS theme) — auto-generated CRUD view.
 *
 * Variables:
 *   $this->model — the {{ objectName }} model instance to display
 */
defined('SP') or die('No startpoint defined...');
$data = $this->model->getData();
$pk   = $this->model->{{ primaryKey }};

/*
 * Columns that hold a picture — the ones whose foreign key references `media`.
 *
 * The address is asked for, never assembled. `sURL . $media->url` is the obvious line
 * and it is wrong twice: `sURL` is the *script's* base, so the same code inside an API
 * request answers `/api/uploads/x.png`, and once a `media` storage disk is configured
 * the file is on a bucket while the concatenation keeps pointing at the local copy.
 */
$mediaColumns = {{ mediaColumns }};
?>
<div class="page-section">
    <?php echo \Pramnos\Application\Application::getInstance()->renderBreadcrumbs(); ?>
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
        <h2 style="margin:0">{{ objectName }}</h2>
        <div style="display:flex;gap:8px">
            <a href="<?php echo sURL; ?>{{ className }}" class="btn btn-outline-secondary">&laquo; Back</a>
            <a href="<?php echo sURL; ?>{{ className }}/edit/<?php echo $pk; ?>" class="btn btn-primary">Edit</a>
            <a href="<?php echo sURL; ?>{{ className }}/delete/<?php echo $pk; ?>" class="btn btn-outline-danger" data-confirm="Delete this {{ objectName }}?">Delete</a>
        </div>
    </div>
    <div class="card" style="border:1px solid #ddd;border-radius:4px">
        <table style="width:100%;border-collapse:collapse;font-size:13px">
            <tbody>
                <?php foreach ($data as $field => $value): ?>
                <tr style="border-top:1px solid #f0f0f0">
                    <th style="padding:8px 14px;text-align:left;width:220px;color:#666;background:#f9f9f9"><?php echo ucwords(str_replace('_', ' ', htmlspecialchars((string) $field))); ?></th>
                    <td style="padding:8px 14px"><?php
                        if (in_array($field, $mediaColumns, true)) {
                            $src = \Pramnos\Media\MediaObject::urlFor($value, 'medium');
                            if ($src === '') { echo '<span style="color:#ccc">—</span>'; }
                            else { echo '<img src="' . htmlspecialchars($src) . '" alt="" style="max-width:320px;height:auto">'; }
                        }
                        elseif (is_bool($value)) { echo $value ? 'Yes' : 'No'; }
                        elseif ($value === null || $value === '') { echo '<span style="color:#ccc">—</span>'; }
                        elseif (is_array($value)) { echo '<pre style="margin:0">' . htmlspecialchars((string) json_encode($value, JSON_PRETTY_PRINT)) . '</pre>'; }
                        else { echo htmlspecialchars((string) $value); }
                    ?></td>
                </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>
</div>
