import { render, screen, fireEvent, waitFor } from '@testing-library/svelte';
import { vi, describe, it, expect, beforeEach, afterEach } from 'vitest';
import NotificationBell from '../components/NotificationBell.svelte';

/**
 * Tests for the notification bell.
 *
 * Through the real `lib/api.js`, with only `fetch` stubbed, answering as
 * `Pramnos\Notification\FeedApi` answers: `{status, data: {…}}`. What matters: no badge at
 * nought, the latest read when it is opened, and reading one — or all — asks the server and
 * draws what it then answers.
 */

/** One notification, as the feed lists it. */
const item = (id, title, read = false) => ({ id, title, message: 'About ' + title, url: '#' + id, read, created_at: '2026-10-19 10:00:00' });

let calls;
let feed;

vi.mock('../lib/i18n.svelte.js', () => ({ t: (s) => s }));

beforeEach(() => {
    calls = [];
    feed  = { items: [item('a', 'First'), item('b', 'Second', true)], unread: 1 };
    vi.stubGlobal('fetch', vi.fn(async (url, init = {}) => {
        const address = new URL(url, 'http://localhost');
        const path    = address.pathname.replace(/^.*\/notifications/, '/notifications');
        calls.push({ path, method: init.method ?? 'GET', body: init.body ? JSON.parse(init.body) : null, query: Object.fromEntries(address.searchParams) });
        if (path === '/notifications/read') {
            feed = { items: feed.items.map((i) => ({ ...i, read: true })), unread: 0 };
        }
        if (path === '/notifications/readall') {
            feed = { items: feed.items.map((i) => ({ ...i, read: true })), unread: 0 };
        }
        const body = { status: 200, data: { ...feed, total: feed.items.length, page: 1, pages: 1 } };

        return { status: 200, ok: true, json: async () => body };
    }));
});

afterEach(() => {
    vi.unstubAllGlobals();
});

describe('NotificationBell', () => {
    it('shows the unread count, and no badge at nought', async () => {
        // Arrange / Act
        render(NotificationBell, { interval: 0 });

        // Assert — the feed was asked for, ten at a time
        await waitFor(() => expect(screen.getByText('1')).toBeTruthy());
        expect(calls[0].path).toBe('/notifications');
        expect(calls[0].query.per_page).toBe('10');
    });

    it('lists the latest when opened, and reads one when it is followed', async () => {
        // Arrange
        render(NotificationBell, { interval: 0 });
        await waitFor(() => expect(screen.getByText('1')).toBeTruthy());

        // Act
        await fireEvent.click(screen.getByRole('button', { name: 'Notifications, 1' }));
        const first = await screen.findByText('First');
        await fireEvent.click(first);

        // Assert — the read was posted with its id, and the badge went
        await waitFor(() => expect(calls.some((c) => c.path === '/notifications/read' && c.body?.id === 'a')).toBe(true));
        await waitFor(() => expect(screen.queryByText('1')).toBeNull());
    });

    it('marks all read, and closes on Escape', async () => {
        // Arrange
        render(NotificationBell, { interval: 0 });
        await waitFor(() => expect(screen.getByText('1')).toBeTruthy());
        await fireEvent.click(screen.getByRole('button', { name: 'Notifications, 1' }));

        // Act
        await fireEvent.click(await screen.findByText('Mark all read'));
        await waitFor(() => expect(calls.some((c) => c.path === '/notifications/readall')).toBe(true));
        await fireEvent.keyDown(document, { key: 'Escape' });

        // Assert
        await waitFor(() => expect(screen.queryByRole('menu')).toBeNull());
    });

    it('says so when there is nothing', async () => {
        // Arrange
        feed = { items: [], unread: 0 };
        render(NotificationBell, { interval: 0 });

        // Act
        await fireEvent.click(await screen.findByRole('button', { name: 'Notifications' }));

        // Assert
        expect(await screen.findByText('No notifications')).toBeTruthy();
    });
});
