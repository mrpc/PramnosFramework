/**
 * Client-side routing for the {{ appName }} SPA.
 *
 * Every screen has a real URL. That is not decoration: without it the back
 * button leaves the application, a page cannot be linked to or bookmarked, a
 * refresh loses the user's place, and an error report cannot say *where* it
 * happened. The server already cooperates — any unmatched page request renders
 * the shell — so the History API is all that is missing.
 *
 * ## What this version adds, and why it is not optional
 *
 * The first version of this file resolved a **route name** and nothing else. A
 * generated CRUD screen therefore had nowhere to put its page number, its search
 * term or its sort order except component state — and component state is exactly
 * what a background refresh resets. The symptom is somebody on page 7 of a queue
 * being silently returned to page 1 by a refresh they did not ask for, and a
 * search that cannot be sent to a colleague.
 *
 * So the route now carries `segments` and `query`, and **the URL is the state**:
 *
 *   - `/things?page=7&q=ada&sort=name&dir=desc` is a link to that view.
 *   - A re-read re-reads the same thing, because the page number is in the route
 *     rather than in a variable.
 *   - `/things/42` reaches a record without a second routing mechanism.
 *
 * A screen never stores page/search/sort. It **derives** them from `route.query`
 * and calls `go()` to change them. That is one direction of data flow, and it is
 * what removes the whole class of bug rather than patching instances of it.
 *
 * ## Not SvelteKit
 *
 * A history router with query parsing and click interception is about a hundred
 * lines, and it keeps the scaffolded project on the stack the framework can
 * actually emit — plain Svelte 5 + Vite, no file-based routing conventions, no
 * second build mode. File-based routing is worth more in a large application
 * than it costs; it is worth less than a dependency in a generated one.
 */
import { screens } from '../screens/registry.js';
import { reportRoute } from './debug.js';

/** Where the application is mounted ('' at the site root, '/app' in hybrid). */
export const BASE = '{{ routerBase }}';

/**
 * Parse a location into a route.
 *
 * Trailing slashes are normalised away: `/things` and `/things/` are the same
 * page, and treating them as two gives you two cache entries and two "current"
 * states for one screen.
 *
 * @param {string} [href] Defaults to the current location.
 * @returns {{name: string, path: string, segments: string[], query: URLSearchParams}}
 */
export function parse(href = window.location.href) {
    const url = new URL(href, window.location.origin);
    let path = url.pathname;

    if (BASE !== '' && path.startsWith(BASE)) {
        path = path.slice(BASE.length);
    }

    path = path.replace(/\/+$/, '') || '/';

    const segments = path.split('/').filter(Boolean);

    return {
        name: routeFor(path),
        path,
        segments,
        query: url.searchParams,
    };
}

/**
 * The route name for a path, or 'home' when nothing matches.
 *
 * Matching is on the **first segment**, so `/things/42` and `/things` are the
 * same screen — the screen reads `segments[1]` and decides. Without that, every
 * detail view would need its own registry entry.
 *
 * An unknown path resolving to home rather than a blank page is deliberate: a
 * mistyped or outdated link should land somewhere usable.
 */
export function routeFor(pathname) {
    // 'signin' rather than 'login': the server-rendered login page owns /login
    // (password reset, 2FA and the OAuth flows live there), so the SPA's own
    // sign-in screen takes a path of its own instead of shadowing it.
    const known = ['signin', ...screens.map((s) => s.name)];
    const first = pathname.replace(BASE, '').replace(/^\/+|\/+$/g, '').split('/')[0];

    return known.includes(first) ? first : 'home';
}

/**
 * Build an in-application href. Always absolute, so `<a href>` is correct from
 * any depth.
 *
 * Empty, null and undefined query values are dropped rather than emitted as
 * `&q=`: a URL that carries a blank parameter is a different URL from one that
 * carries none, and the two would be two cache keys for one view.
 */
export function href(path, query = null) {
    let url = BASE + (path.startsWith('/') ? path : '/' + path);

    if (query) {
        const params = new URLSearchParams(
            Object.entries(query).filter(([, v]) => v !== null && v !== undefined && v !== '')
        );
        const qs = params.toString();

        if (qs) {
            url += '?' + qs;
        }
    }

    return url;
}

/** The path of a route name — kept for callers written against the first version. */
export function pathFor(name) {
    return name === 'home' ? (BASE || '/') : `${BASE}/${name}`;
}

/**
 * Navigate programmatically.
 *
 * @param {string}  path
 * @param {object}  [query]
 * @param {boolean} [options.replace] Replace the entry instead of adding one —
 *                                    for a redirect, so the back button does not
 *                                    bounce the user into the page that just
 *                                    refused them.
 */
export function go(path, query = null, { replace = false } = {}) {
    const url = href(path, query);

    if (replace) {
        window.history.replaceState({}, '', url);
    } else {
        window.history.pushState({}, '', url);
    }

    window.dispatchEvent(new PopStateEvent('popstate'));
}

/**
 * Start listening, and call back with the current route.
 *
 * Intercepts same-origin in-application clicks so navigation is instant, while
 * leaving everything that should behave like a real link alone: modified clicks
 * (ctrl/cmd/shift/alt — the ones that open a new tab), `target`, `download`, and
 * any href outside the application. That list is the difference between "we have
 * anchors" and "open in a new tab actually works".
 *
 * One listener on the window rather than a handler per link: a generated table
 * has a link per row, and per-link handlers mean the interception has to be
 * remembered every time somebody writes an anchor.
 *
 * @param {(route: ReturnType<typeof parse>) => void} onRoute
 * @returns {() => void} A teardown function.
 */
export function start(onRoute) {
    const emit = () => {
        const route = parse();

        // The debug panel cannot work the route out for itself: the route table
        // is this file's, and a base that does not match the URL is precisely
        // the failure worth showing ("the deep link that 404s"). Inert in
        // production, like the rest of lib/debug.js.
        reportRoute(route.name, { base: BASE, path: route.path });
        onRoute(route);
    };

    const onClick = (event) => {
        if (event.defaultPrevented || event.button !== 0) {
            return;
        }

        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
            return;
        }

        const anchor = event.target.closest?.('a[href]');

        if (!anchor || anchor.target || anchor.hasAttribute('download')) {
            return;
        }

        const url = new URL(anchor.href, window.location.origin);

        if (url.origin !== window.location.origin || !url.pathname.startsWith(BASE || '/')) {
            return;
        }

        event.preventDefault();

        if (url.href !== window.location.href) {
            window.history.pushState({}, '', url.href);
            emit();
        }
    };

    window.addEventListener('click', onClick);
    window.addEventListener('popstate', emit);
    emit();

    return () => {
        window.removeEventListener('click', onClick);
        window.removeEventListener('popstate', emit);
    };
}
