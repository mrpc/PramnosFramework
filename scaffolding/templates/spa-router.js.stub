/**
 * Client-side routing for the {{ appName }} SPA.
 *
 * Every screen has a real URL. That is not decoration: without it the back
 * button leaves the application, a page cannot be linked to or bookmarked, a
 * refresh loses the user's place, and an error report cannot say *where* it
 * happened. The server already cooperates — any unmatched page request renders
 * the shell — so the History API is all that is missing.
 *
 * Routes are derived from the screen registry, so a screen generated by
 * `create:crud` gets its URL without anyone editing this file.
 */
import { screens } from '../screens/registry.js';
import { reportRoute } from './debug.js';

/** Where the application is mounted ('' at the site root, '/app' in hybrid). */
export const BASE = '{{ routerBase }}';

/**
 * The path of a route name.
 *
 * @param {string} name
 * @returns {string}
 */
export function pathFor(name) {
    return name === 'home' ? (BASE || '/') : `${BASE}/${name}`;
}

/**
 * The route name for a path, or 'home' when nothing matches.
 *
 * An unknown path resolving to home rather than a blank page is deliberate: a
 * mistyped or outdated link should land somewhere usable.
 *
 * @param {string} pathname
 * @returns {string}
 */
export function routeFor(pathname) {
    // 'signin' rather than 'login': the server-rendered login page owns /login
    // (password reset, 2FA and the OAuth flows live there), so the SPA's own
    // sign-in screen takes a path of its own instead of shadowing it.
    const known = ['signin', 'admin', ...screens.map((s) => s.name)];
    const rest  = pathname.replace(BASE, '').replace(/^\/+|\/+$/g, '');

    return known.includes(rest) ? rest : 'home';
}

/**
 * Create the router state.
 *
 * Returns an object with a reactive `current` — reassigned on navigation — plus
 * `go()` for programmatic moves and `link()` for anchor click handling. It is a
 * factory rather than a module-level singleton so tests can drive one without
 * touching the real history.
 *
 * @param {(name: string) => void} onChange Called with the new route name
 */
export function createRouter(onChange) {
    /**
     * Announce wherever we are now — to the application, and to the debug panel.
     *
     * The panel cannot work the route out for itself: the route table is this
     * file's, and a base that does not match the URL is precisely the failure
     * worth showing ("the deep link that 404s"). reportRoute is inert in
     * production, like the rest of lib/debug.js.
     */
    const announce = () => {
        const name = routeFor(window.location.pathname);
        reportRoute(name, { base: BASE });
        onChange(name);
    };

    window.addEventListener('popstate', announce);

    return {
        /**
         * Navigate to a route, adding a history entry.
         *
         * @param {string} name
         * @param {boolean} [replace] Replace the entry instead of adding one —
         *                            used by redirects, so the back button does
         *                            not bounce the user into the page that just
         *                            refused them.
         */
        go(name, replace = false) {
            const path = pathFor(name);
            if (window.location.pathname !== path) {
                window.history[replace ? 'replaceState' : 'pushState']({}, '', path);
            }
            reportRoute(name, { base: BASE });
            onChange(name);
        },

        /**
         * Handle a click on an in-application link.
         *
         * Modified clicks (new tab, download, middle button) are left to the
         * browser: hijacking them is the classic SPA sin.
         *
         * @param {MouseEvent} event
         * @param {string} name
         */
        link(event, name) {
            if (event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) {
                return;
            }
            event.preventDefault();
            this.go(name);
        },

        /** Adopt whatever URL the page was loaded with. */
        start: announce,
    };
}
