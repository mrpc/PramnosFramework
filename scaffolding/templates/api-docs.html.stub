<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <script type="module" src="https://unpkg.com/rapidoc@9.3.4/dist/rapidoc-min.js"></script>
  <style>body { margin: 0; padding: 0; }</style>
</head>
<body>
  <!--
    API documentation viewer, generated by `pramnos api:docs`.

    Renders the sibling OpenAPI spec with RapiDoc. The spec itself is generated
    from the #[Route] attributes on the app's controllers, so this page always
    reflects the live routes — regenerate both with `pramnos api:docs`.
  -->
  <rapi-doc
    spec-url="{{ spec }}"
    render-style="read"
    theme="dark"
    show-header="true"
    allow-try="true"
    regular-font="Open Sans, sans-serif">
  </rapi-doc>
</body>
</html>
