<script>
    /**
     * {{ entityLabel }}.
     *
     * Generated by `create:screen --blank`. Two things it already does, both of
     * which are the convention in this application rather than this screen's
     * preference:
     *
     *  - **It takes `route`.** Page, filter and selection state belong in the URL
     *    (see `lib/router.js`), so they are *derived* from `route.query` and
     *    changed with `go()`. A screen that stores them in component state is a
     *    screen a background refresh can silently reset, and a view nobody can
     *    link to.
     *
     *  - **It reports its own failure.** A screen whose fetch throws and does
     *    nothing shows an empty page, and an empty page is a believable and wrong
     *    answer — it reads as "there is nothing here".
     */
    import { api, ApiError } from '../lib/api.js';
    import { go } from '../lib/router.js';
    import { t } from '../lib/i18n.svelte.js';

    let { route } = $props();

    let data    = $state(null);
    let loading = $state(true);
    let error   = $state(null);

    // Derived from the route, not stored: see the note above.
    // const filter = $derived(route.query.get('filter') ?? '');

    $effect(() => {
        load();
    });

    async function load() {
        loading = true;
        error = null;

        try {
            data = await api.get('{{ apiPrefix }}/status');
        } catch (failure) {
            error = failure instanceof ApiError
                ? t('Could not load: HTTP %s', failure.status)
                : t('Could not reach the API.');
        } finally {
            loading = false;
        }
    }
</script>

<div class="space-y-4">
    <h1 class="text-2xl font-medium">{t('{{ entityLabel }}')}</h1>

    {#if error}
        <div class="alert alert-error" role="alert">{error}</div>
    {:else if loading}
        <div class="flex justify-center py-16">
            <span class="loading loading-spinner loading-lg"></span>
        </div>
    {:else}
        <div class="card bg-base-100 border border-base-content/10">
            <div class="card-body">
                <pre class="text-xs overflow-x-auto">{JSON.stringify(data, null, 2)}</pre>
            </div>
        </div>
    {/if}
</div>
