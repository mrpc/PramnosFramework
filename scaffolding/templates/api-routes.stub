{{ router }}->delete(
    '/{{ modelClassLower }}/{{{ primaryKey }}}',
    function (${{ primaryKey }}) {
        return (new \{{ apiNamespace }}\{{ className }}($this))->delete{{ modelClass }}(${{ primaryKey }});
    }
);

{{ router }}->put(
    '/{{ modelClassLower }}/{{{ primaryKey }}}',
    function (${{ primaryKey }}) {
        return (new \{{ apiNamespace }}\{{ className }}($this))->update{{ modelClass }}(${{ primaryKey }});
    }
);

{{ router }}->get(
    '/{{ modelClassLower }}/{{{ primaryKey }}}',
    function (${{ primaryKey }}) {
        return (new \{{ apiNamespace }}\{{ className }}($this))->read{{ modelClass }}(${{ primaryKey }});
    }
);

{{ router }}->get(
    '/{{ modelClassLower }}',
    function () {
        return (new \{{ apiNamespace }}\{{ className }}($this))->display();
    }
);

{{ router }}->post(
    '/{{ modelClassLower }}',
    function () {
        return (new \{{ apiNamespace }}\{{ className }}($this))->create{{ modelClass }}();
    }
);
