/*
 * Columns that hold a picture — the ones whose foreign key references `media`.
 *
 * The address is asked for, never assembled. `sURL . $media->url` is the obvious line
 * and it is wrong twice: `sURL` is the *script's* base, so the same code inside an API
 * request answers `/api/uploads/x.png`, and once a `media` storage disk is configured
 * the file is on a bucket while the concatenation keeps pointing at the local copy.
 */
$mediaColumns = {{ mediaColumns }};
