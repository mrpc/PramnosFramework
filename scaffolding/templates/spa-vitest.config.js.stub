/**
 * Vitest configuration for the {{ appName }} front end.
 *
 * Separate from vite.config.js on purpose: the build config carries a `base`
 * and an `outDir` that mean nothing to the test run, and keeping the two apart
 * means a change to the deploy layout can never break the tests.
 *
 * jsdom gives the components a DOM; `globals: true` exposes describe/it/expect
 * without an import in every file.
 */
import { defineConfig } from 'vitest/config';
{{ pluginImports }}
export default defineConfig({
    plugins: [{{ pluginList }}],
    resolve: {
        // Without this, Vitest resolves the *server* build of component
        // libraries and mounting fails with "mount(...) is not available on the
        // server" — jsdom is a browser environment, so ask for the browser
        // export condition explicitly.
        conditions: ['browser'],
    },
    test: {
        environment: 'jsdom',
        globals: true,
        include: ['{{ sourceDir }}/**/*.{test,spec}.js'],
        coverage: {
            provider: 'v8',
            include: ['{{ sourceDir }}/**/*.{js,svelte}'],
            exclude: [
                '{{ sourceDir }}/**/*.{test,spec}.js',
                /*
                 * The debug panel is the framework's, not this project's.
                 *
                 * It is generated from the framework's own toolbar source rather than
                 * scaffolded as a starting point, it is about four thousand lines, it
                 * ships unconditionally, and CLAUDE.md tells you not to rewrite it. The
                 * framework tests it where it is owned, in its own JavaScript suite.
                 *
                 * Left in, it decides the number: a project measured 47.8% with it and
                 * 81.5% without, on the same tests. A figure that moves that far on a file
                 * nobody here is allowed to touch is not a figure anybody acts on — and
                 * the way that ends is somebody deleting the threshold rather than writing
                 * a test.
                 *
                 * Every other file under this directory is yours, including the shared
                 * components: those are scaffolded to be extended, so they are measured.
                 */
                '{{ sourceDir }}/lib/debug.js',
            ],
        },
    },
});
