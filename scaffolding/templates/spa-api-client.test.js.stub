/**
 * Tests for the {{ appName }} API client.
 *
 * The client is the single place where the framework's API contract lives, so
 * these cover exactly that contract: the mandatory `apiKey` header (without it
 * the API answers 403 "API key is missing"), the framework's `accessToken`
 * header for a bearer session, cookies for a server-rendered login, JSON
 * encoding, 204, and errors that keep their HTTP status.
 */
import { describe, it, expect, vi, beforeEach, afterEach } from 'vitest';
import { api, request, setToken, getToken, login, logout, currentUser, ApiError } from '../lib/api.js';

beforeEach(() => {
    setToken(null);
});

afterEach(() => {
    setToken(null);
    vi.unstubAllGlobals();
});

/**
 * Stub global fetch with one canned response and hand back the spy.
 *
 * @param {*}      body
 * @param {number} status
 */
function stubFetch(body, status = 200) {
    const spy = vi.fn(async () => ({
        ok: status >= 200 && status < 300,
        status,
        json: async () => body,
    }));
    vi.stubGlobal('fetch', spy);
    return spy;
}

describe('api client', () => {
    it('sends the apiKey header the API requires', async () => {
        // Arrange — the shell injects the application's own key
        vi.stubGlobal('window', { __PRAMNOS__: { apiPrefix: '{{ apiPrefix }}', apiKey: 'k3y' } });
        const spy = stubFetch({ status: 'ok' });

        // Act
        await api.get('/status');

        // Assert — without this header every call is a 403
        const [, options] = spy.mock.calls[0];
        expect(options.headers.apiKey).toBeDefined();
    });

    it('prefixes the path and sends the session cookie', async () => {
        // Arrange
        const spy = stubFetch({ status: 'ok' });

        // Act
        await api.get('/status');

        // Assert — same-origin credentials are what make cookie auth work
        const [url, options] = spy.mock.calls[0];
        expect(url).toBe('{{ apiPrefix }}/status');
        expect(options.credentials).toBe('same-origin');
        expect(options.headers.accessToken).toBeUndefined();
    });

    it('sends the framework accessToken header, not Authorization', async () => {
        // Arrange
        const spy = stubFetch({ status: 'ok' });
        setToken('t0ken');

        // Act
        await api.get('/status');

        // Assert
        const [, options] = spy.mock.calls[0];
        expect(options.headers.accessToken).toBe('t0ken');
    });

    it('JSON-encodes a body and sets the content type', async () => {
        // Arrange
        const spy = stubFetch({ id: 1 });

        // Act
        await api.post('/things', { name: 'x' });

        // Assert
        const [, options] = spy.mock.calls[0];
        expect(options.method).toBe('POST');
        expect(options.headers['Content-Type']).toBe('application/json');
        expect(JSON.parse(options.body)).toEqual({ name: 'x' });
    });

    it('decodes 204 as null instead of failing to parse an empty body', async () => {
        // Arrange
        stubFetch(null, 204);

        // Act + Assert
        await expect(api.delete('/things/1')).resolves.toBeNull();
    });

    it('throws an ApiError carrying the status for a failing request', async () => {
        // Arrange
        stubFetch({ message: 'nope' }, 422);

        // Act + Assert — the status must survive, so callers can branch on it
        await expect(request('/things')).rejects.toMatchObject({ name: 'ApiError', status: 422 });
    });

    it('still reports the status when the error body is not JSON', async () => {
        // Arrange — a proxy error page: response.json() rejects
        vi.stubGlobal('fetch', vi.fn(async () => ({
            ok: false,
            status: 502,
            json: async () => { throw new SyntaxError('not json'); },
        })));

        // Act + Assert — the decode failure must not mask the real status
        await expect(request('/things')).rejects.toMatchObject({ status: 502 });
    });
});

describe('authentication', () => {
    it('stores the issued token so later calls are authenticated', async () => {
        // Arrange
        stubFetch({ status: 'success', access_token: 'issued', user: { username: 'jo' } });

        // Act
        const user = await login('jo', 'secret');

        // Assert
        expect(user).toEqual({ username: 'jo' });
        expect(getToken()).toBe('issued');
    });

    it('forgets the token on logout even if the call fails', async () => {
        // Arrange — an expired token: the server rejects the logout
        setToken('stale');
        stubFetch({ message: 'invalid' }, 401);

        // Act
        await logout();

        // Assert — the client must stop presenting a token the server refused
        expect(getToken()).toBeNull();
    });

    it('reports an anonymous visitor as null rather than throwing', async () => {
        // Arrange
        stubFetch({ error: 'not_authenticated' }, 401);

        // Act + Assert — "nobody is signed in" is an answer, not an error
        await expect(currentUser()).resolves.toBeNull();
    });
});
