<?php
declare(strict_types=1);

namespace {{ namespace }}\Services;

use Pramnos\Application\Service;

/**
 * Application status — the first service of a Services + API + SPA project.
 *
 * It exists for two reasons: the SPA needs something real to call on its first
 * screen, and this is the shape every other service should follow — extend the
 * framework's Service base, one intention-revealing method, all data access
 * inside. Replace or delete it once the app has services of its own.
 *
 * The base class is what makes this service appear in the debug toolbar's Domain
 * tab, and `measure()` is what puts a duration next to the call.
 */
class StatusService extends Service
{
    /**
     * A snapshot of what the backend can tell an anonymous caller.
     *
     * Deliberately free of anything sensitive: it is served without
     * authentication, so no versions of internal components, no paths, no
     * configuration values.
     *
     * @return array<string, mixed>
     */
    public function snapshot(): array
    {
        return $this->measure('snapshot', fn(): array => [
            'application' => '{{ appName }}',
            'status'      => 'ok',
            'database'    => $this->databaseIsReachable() ? 'up' : 'down',
            'time'        => gmdate('c'),
        ]);
    }

    /**
     * Can the application reach its database right now?
     *
     * Any failure is an answer, not an exception: the endpoint's job is to
     * report the state, and a status page that itself 500s is useless.
     */
    private function databaseIsReachable(): bool
    {
        try {
            $this->database()->query('SELECT 1');
            return true;
        } catch (\Throwable) {
            return false;
        }
    }
}
