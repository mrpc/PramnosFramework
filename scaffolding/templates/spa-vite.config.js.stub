/**
 * Vite build for the {{ appName }} single-page application.
 *
 * The build writes content-hashed assets plus a manifest into
 * `www/assets/spa/`, which the PHP shell (www/{{ shellFile }}) reads to emit the
 * right <script>/<link> tags. Nothing is served by Vite in production — Apache
 * serves the built files, so the app has no Node runtime dependency.
 *
 * `npm run dev` starts Vite's dev server with HMR on port {{ devPort }}; point
 * your browser at it while the PHP API keeps running in the container. Requests
 * to /api are proxied to Apache so the SPA talks to the real backend.
 */
import { defineConfig } from 'vite';
{{ pluginImports }}
export default defineConfig({
    // Assets are requested from the web root, not from /
    base: '{{ assetBase }}',
    plugins: [{{ pluginList }}],
    build: {
        outDir: '{{ outDir }}',
        emptyOutDir: true,
        // The manifest is how the PHP shell learns the hashed filenames.
        manifest: true,
        rollupOptions: {
            input: '{{ entry }}',
        },
    },
    server: {
        host: true,
        port: {{ devPort }},
        strictPort: true,
        proxy: {
            '/api': {
                target: 'http://localhost:{{ appPort }}',
                changeOrigin: true,
            },
        },
    },
});
