/**
 * Client for the {{ appName }} JSON API.
 *
 * It speaks the framework's actual API contract, so screens never have to think
 * about it:
 *
 *   - **`apiKey` header on every request.** The API layer rejects anything
 *     without one ("API key is missing", HTTP 403). The shell derives this
 *     application's own key and hands it over in `window.__PRAMNOS__`, so
 *     nothing is hard-coded and it stays correct in every environment.
 *   - **`accessToken` header** for a bearer session — the framework's own header
 *     name, not `Authorization`. `login()` stores the token it receives and
 *     every later call carries it.
 *   - **Cookies** are sent as well (`credentials: 'same-origin'`), so a user who
 *     signed in through the server-rendered pages is already authenticated here:
 *     UnifiedAuthMiddleware accepts the web session for same-origin requests.
 *
 * Errors arrive as ApiError with the HTTP status attached, so a screen can react
 * to 401 (sign in again) or 422 (field errors) instead of parsing messages.
 */

import { record as recordDebug, reportError as reportDebugError } from './debug.js';

/** Fallback prefix, used when the shell injected no configuration. */
const DEFAULT_PREFIX = '{{ apiPrefix }}';

/**
 * Runtime configuration injected by the PHP shell (`window.__PRAMNOS__`).
 *
 * Read per call rather than captured at import time: a module may be evaluated
 * before the shell's inline script in some bundling setups, and tests set it up
 * after importing. Reading late costs nothing and cannot go stale.
 *
 * @returns {{apiPrefix?: string, apiKey?: string, features?: object}}
 */
function config() {
    return (typeof window !== 'undefined' && window.__PRAMNOS__) || {};
}

/** Where the bearer token is kept between page loads. */
const TOKEN_KEY = '{{ tokenStorageKey }}';

/**
 * In-memory copy of the token.
 *
 * localStorage is unavailable in private mode, when storage is blocked, and
 * outside a browser (tests, SSR). Keeping the token here as well means those
 * environments still authenticate — they just do not survive a reload.
 */
let memoryToken = null;

/** An HTTP-level API failure, carrying the status and decoded payload. */
export class ApiError extends Error {
    /**
     * @param {string} message Human-readable summary
     * @param {number} status  HTTP status code
     * @param {*}      payload Decoded response body, when there was one
     */
    constructor(message, status, payload) {
        super(message);
        this.name    = 'ApiError';
        this.status  = status;
        this.payload = payload;
    }
}

/**
 * The stored bearer token, if any.
 *
 * @returns {string|null}
 */
export function getToken() {
    try {
        return localStorage.getItem(TOKEN_KEY) ?? memoryToken;
    } catch {
        return memoryToken;
    }
}

/**
 * Store (or clear, with null) the bearer token used by later requests.
 *
 * @param {string|null} value
 */
export function setToken(value) {
    memoryToken = value;
    try {
        if (value === null) {
            localStorage.removeItem(TOKEN_KEY);
        } else {
            localStorage.setItem(TOKEN_KEY, value);
        }
    } catch {
        // Ignore: the token simply does not survive a reload.
    }
}

/**
 * Perform an API request and decode the JSON response.
 *
 * @param {string} path              Path below the API prefix, e.g. '/status'
 * @param {object} [options]
 * @param {string} [options.method]  HTTP method (default GET)
 * @param {*}      [options.body]    Payload, JSON-encoded when present
 * @param {object} [options.headers] Extra headers
 * @param {boolean} [options.anonymous] Send no access token (for signing in)
 * @param {AbortSignal} [options.signal] Cancels the request. Needed by anything that
 *   fires a call per keystroke: without it a slow answer to an earlier term can land
 *   after a fast answer to a later one and replace newer results with older.
 * @returns {Promise<*>} Decoded body, or null for 204
 * @throws {ApiError} When the response status is not 2xx
 */
export async function request(path, { method = 'GET', body = null, query = null, headers = {}, anonymous = false, signal = null } = {}) {
    const { apiPrefix = DEFAULT_PREFIX, apiKey = '' } = config();
    const requestHeaders = { Accept: 'application/json', ...headers };

    // Blanks, nulls and undefineds are dropped rather than emitted as `&q=`.
    //
    // A URL carrying an empty parameter is a *different* URL from one carrying
    // none: two cache keys, two "current" states, and a WHERE clause the server
    // did not need to build. `URLSearchParams` also stringifies `undefined` to
    // the four characters "undefined" rather than omitting it. Dropping them
    // here is why no screen has to remember an `if` per parameter — and
    // forgetting one is what made every hand-written list screen slightly
    // different from every other.
    const url = query ? path + queryStringFor(path, query) : path;

    if (apiKey) {
        requestHeaders.apiKey = apiKey;
    }
    // A stored token is presented on every call EXCEPT the ones whose whole
    // purpose is to obtain one. The API validates the token before routing, so
    // a stale or foreign token (a re-deployed application signs with a new key)
    // makes every request fail with InvalidAccessToken — including the login
    // that would replace it. That wedges the application permanently.
    const token = anonymous ? null : getToken();
    if (token) {
        requestHeaders.accessToken = token;
    }
    if (body !== null) {
        requestHeaders['Content-Type'] = 'application/json';
    }

    // Measured around the call so the panel can show what the browser waited
    // for, next to what the server says it spent. The gap between the two is
    // the network, and it is often the answer.
    const startedAt = (typeof performance !== 'undefined' ? performance.now() : Date.now());
    const encodedBody = body === null ? null : JSON.stringify(body);

    let response;
    try {
        response = await fetch(apiPrefix + url, {
            method,
            headers: requestHeaders,
            // Sends the session cookie, which the API accepts as a credential.
            credentials: 'same-origin',
            body: encodedBody,
            signal,
        });
    } catch (error) {
        // A deliberate cancellation is not a failure and must not be reported as one:
        // a search box that aborts a request per keystroke would otherwise fill the
        // debug panel's request tab with network errors that nothing went wrong for.
        if (error?.name === 'AbortError') {
            throw error;
        }

        // A network failure produces no response, so nothing else records it —
        // there is no status, no `_debug`, and the request tab would show
        // nothing at all. This is the one failure mode where the panel would
        // otherwise be empty precisely because something went badly wrong.
        reportDebugError(error, {
            kind: 'network',
            request: { method, path: url, status: 0 },
        });

        throw error;
    }
    const elapsedMs = Math.round(
        (typeof performance !== 'undefined' ? performance.now() : Date.now()) - startedAt
    );

    if (response.status === 204) {
        // A save answers 204, and it is exactly the call somebody wants to see
        // in the panel. It carries no body, so there is no `_debug` to attach —
        // the timing and the request itself are still worth recording.
        recordDebug(method, url, 204, null, { ms: elapsedMs, body: encodedBody });

        return null;
    }

    // A failing endpoint may answer with HTML (a proxy error page), so decoding
    // is attempted but never allowed to mask the real status.
    let payload = null;
    try {
        payload = await response.json();
    } catch {
        payload = null;
    }

    // In development the API attaches its debug data to the response it
    // describes; the panel shows it. In production there is nothing to record.
    recordDebug(method, url, response.status, payload && payload._debug, {
        ms: elapsedMs,
        body: encodedBody,
    });

    if (!response.ok) {
        // A token the server will not accept is worse than no token: it fails
        // every later call the same way. Drop it so the next request is clean
        // and the user can sign in again.
        if (payload && payload.error === 'InvalidAccessToken') {
            setToken(null);
        }

        const detail = payload && payload.message ? `: ${payload.message}` : '';
        const failure = new ApiError(
            `${method} ${url} failed (${response.status})${detail}`,
            response.status,
            payload
        );

        // Reported here rather than left to a global handler: a screen that
        // handles its own 422 never lets this reach `unhandledrejection`, and a
        // handled failure is still a failure worth seeing in the panel next to
        // the request that produced it.
        reportDebugError(failure, {
            kind: 'ApiError',
            request: { method, path: url, status: response.status },
        });

        throw failure;
    }

    return payload;
}

/**
 * The query string for a set of parameters, including the leading separator,
 * or '' when nothing survives the filter.
 *
 * @param {string} path  The path so far — it may already carry a `?`.
 * @param {Record<string, unknown>} query
 * @returns {string}
 */
function queryStringFor(path, query) {
    const params = new URLSearchParams(
        Object.entries(query)
            .filter(([, value]) => value !== null && value !== undefined && value !== '')
            .map(([key, value]) => [key, String(value)])
    );
    const encoded = params.toString();

    if (encoded === '') {
        return '';
    }

    return (path.includes('?') ? '&' : '?') + encoded;
}

export const api = {
    // `get` takes the query as its **second positional argument**, which a list
    // screen always has and the other verbs never do. It was `get(path,
    // options)`, and options are still accepted as the third — but an
    // application that passed an options object second would now have it
    // serialised into the query string. The upgrade note carries the grep that
    // finds those:
    //
    //     grep -rn "api\.get([^)]*," --include=*.js --include=*.svelte .
    //
    // `create:api-client`'s generated endpoints module composes its own query
    // and calls `api.get` with one argument, so it is unaffected and does not
    // need regenerating.
    get:    (path, query, options) => request(path, { ...options, method: 'GET', query }),
    post:   (path, body, options)  => request(path, { ...options, method: 'POST', body }),
    put:    (path, body, options)  => request(path, { ...options, method: 'PUT', body }),
    patch:  (path, body, options)  => request(path, { ...options, method: 'PATCH', body }),
    delete: (path, options)        => request(path, { ...options, method: 'DELETE' }),
};

/**
 * Thrown when the password was right but the account wants a second factor.
 *
 * Not an error in the usual sense — the login is half done and the server is
 * holding the rest. Call `loginTwoFactor(code)` to finish it.
 */
export class TwoFactorRequired extends Error {
    /** @param {string[]} methods Second factors this account can use. */
    constructor(methods) {
        super('This account needs a second factor.');
        this.name = 'TwoFactorRequired';
        this.methods = methods ?? [];
    }
}

/**
 * Sign in and remember the issued bearer token.
 *
 * @param {string} username
 * @param {string} password
 * @throws {TwoFactorRequired} When the account has two-factor authentication on
 * @returns {Promise<object>} The authenticated user
 */
export async function login(username, password) {
    // Explicitly anonymous: signing in must work even when a stale token is
    // still in storage, which is exactly when a user needs it to.
    let result;
    try {
        result = await request('/account/login', {
            method: 'POST',
            body: { username, password },
            anonymous: true,
        });
    } catch (error) {
        // The password was accepted; the account simply needs more. The pending
        // login lives server-side, so nothing has to be carried here.
        if (error instanceof ApiError && error.payload?.error === 'two_factor_required') {
            throw new TwoFactorRequired(error.payload.methods);
        }
        throw error;
    }
    if (result && result.access_token) {
        setToken(result.access_token);
    }
    return result ? result.user : null;
}

/**
 * Finish a sign-in that asked for a second factor.
 *
 * @param {string} code The code from the authenticator app, or a backup code
 * @returns {Promise<object>} The authenticated user
 */
export async function loginTwoFactor(code) {
    const result = await request('/account/login2fa', {
        method: 'POST',
        body: { code },
        anonymous: true,
    });
    if (result && result.access_token) {
        setToken(result.access_token);
    }
    return result ? result.user : null;
}

/**
 * Revoke the current token server-side and forget it locally.
 */
export async function logout() {
    try {
        await api.post('/account/logout', {});
    } catch {
        // An expired or already-revoked token still means "signed out" here:
        // failing to log out is not a state a user can act on.
    } finally {
        setToken(null);
    }
}

/**
 * The current user, or null when nobody is signed in.
 *
 * A 401 here is the normal "not signed in" answer, not an error worth throwing
 * at a screen that is only asking who the visitor is.
 *
 * @returns {Promise<object|null>}
 */
export async function currentUser() {
    try {
        const result = await api.get('/me');
        return result && result.data ? result.data : result;
    } catch (err) {
        if (err instanceof ApiError && (err.status === 401 || err.status === 403)) {
            return null;
        }
        throw err;
    }
}

export default api;
