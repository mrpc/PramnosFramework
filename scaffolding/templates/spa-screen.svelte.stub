<script>
    /**
     * {{ entityLabel }} — list, create, edit and delete.
     *
     * Generated by `create:crud`. It talks to the API controller generated
     * beside it, which sits on the same model the MVC side uses: one domain
     * object, two controllers.
     *
     * The list endpoint is the model's getApiList() pipeline, so paging and
     * search are the server's, not the browser's — the screen never loads the
     * whole table to filter it locally.
     */
    import { api, ApiError } from '../lib/api.js';

    const RESOURCE = '/{{ resource }}';
    const KEY      = '{{ primaryKey }}';
    const COLUMNS  = {{ columnsJson }};

    let rows      = $state([]);
    let total     = $state(0);
    let page      = $state(1);
    let perPage   = $state(20);
    let search    = $state('');
    let loading   = $state(true);
    let error     = $state(null);

    /** The record being edited (null = the list is showing). */
    let editing   = $state(null);
    let saving    = $state(false);
    let formError = $state(null);

    const pages = $derived(Math.max(1, Math.ceil(total / perPage)));

    /** Load one page from the API. */
    async function load() {
        loading = true;
        error   = null;
        try {
            // Parameter names are the ones the generated API controller
            // reads (page/limit/search/sort), and the envelope is the one
            // getApiList() returns: { data, pagination: { totalitems, … } }.
            const params = new URLSearchParams({ page: String(page), limit: String(perPage) });
            if (search) {
                params.set('search', search);
            }
            const result = await api.get(`${RESOURCE}?${params}`);
            rows  = result.data ?? [];
            total = result.pagination?.totalitems ?? rows.length;
        } catch (err) {
            error = err instanceof ApiError
                ? `Could not load: HTTP ${err.status}`
                : 'Could not reach the API.';
        } finally {
            loading = false;
        }
    }

    $effect(() => { load(); });

    /** Start a new record, with every editable column blank. */
    function startCreate() {
        editing   = Object.fromEntries(COLUMNS.map((c) => [c, '']));
        formError = null;
    }

    /** Edit an existing row (a copy, so cancelling changes nothing). */
    function startEdit(row) {
        editing   = { ...row };
        formError = null;
    }

    /** Create or update, then go back to the list. */
    async function save(event) {
        event.preventDefault();
        saving    = true;
        formError = null;
        try {
            const id = editing[KEY];
            if (id) {
                await api.put(`${RESOURCE}/${id}`, editing);
            } else {
                await api.post(RESOURCE, editing);
            }
            editing = null;
            await load();
        } catch (err) {
            formError = err instanceof ApiError && err.status === 422
                ? 'Some fields are invalid.'
                : 'Could not save.';
        } finally {
            saving = false;
        }
    }

    /** Delete a row after confirming. */
    async function remove(row) {
        if (!confirm('Delete this record?')) {
            return;
        }
        try {
            await api.delete(`${RESOURCE}/${row[KEY]}`);
            await load();
        } catch (err) {
            error = 'Could not delete.';
        }
    }

    /** Search resets to the first page, or results would be a page deep. */
    function submitSearch(event) {
        event.preventDefault();
        page = 1;
        load();
    }
</script>

<div class="card bg-base-100 shadow">
    <div class="card-body">
        <div class="flex flex-wrap items-center gap-3">
            <h2 class="card-title">{{ entityLabel }}</h2>
            <form class="ml-auto join" onsubmit={submitSearch}>
                <input class="input input-bordered input-sm join-item" placeholder="Search" bind:value={search} />
                <button class="btn btn-sm join-item" type="submit">Search</button>
            </form>
            <button class="btn btn-primary btn-sm" onclick={startCreate}>New</button>
        </div>

        {#if error}
            <div role="alert" class="alert alert-error mt-3"><span>{error}</span></div>
        {/if}

        {#if editing}
            <form class="mt-4 grid gap-3 md:grid-cols-2" onsubmit={save}>
                {#each COLUMNS as column}
                    <label class="form-control">
                        <span class="label-text">{column}</span>
                        <input class="input input-bordered" bind:value={editing[column]} />
                    </label>
                {/each}

                {#if formError}
                    <div role="alert" class="alert alert-error md:col-span-2"><span>{formError}</span></div>
                {/if}

                <div class="flex gap-2 md:col-span-2">
                    <button class="btn btn-primary" type="submit" disabled={saving}>
                        {saving ? 'Saving…' : 'Save'}
                    </button>
                    <button class="btn" type="button" onclick={() => (editing = null)}>Cancel</button>
                </div>
            </form>
        {:else if loading}
            <span class="loading loading-spinner loading-md mt-4"></span>
        {:else}
            <div class="mt-4 overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            {#each COLUMNS as column}<th>{column}</th>{/each}
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {#each rows as row}
                            <tr>
                                {#each COLUMNS as column}<td>{row[column] ?? ''}</td>{/each}
                                <td class="flex gap-2">
                                    <button class="btn btn-xs" onclick={() => startEdit(row)}>Edit</button>
                                    <button class="btn btn-xs btn-error" onclick={() => remove(row)}>Delete</button>
                                </td>
                            </tr>
                        {:else}
                            <tr><td colspan={COLUMNS.length + 1}>Nothing here yet.</td></tr>
                        {/each}
                    </tbody>
                </table>
            </div>

            <div class="mt-3 flex items-center gap-3">
                <div class="join">
                    <button class="btn btn-sm join-item" disabled={page <= 1} onclick={() => { page -= 1; load(); }}>«</button>
                    <button class="btn btn-sm join-item">{page} / {pages}</button>
                    <button class="btn btn-sm join-item" disabled={page >= pages} onclick={() => { page += 1; load(); }}>»</button>
                </div>
                <span class="text-sm opacity-70">{total} records</span>
            </div>
        {/if}
    </div>
</div>
