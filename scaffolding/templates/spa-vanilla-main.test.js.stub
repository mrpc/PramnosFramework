/**
 * Tests for the {{ appName }} SPA entry point.
 *
 * boot() and render() are exported separately precisely so the API outcome can
 * be asserted without a DOM and the DOM work without a network. Both matter: a
 * failed API call must reach the user as visible text, never an empty page.
 */
import { describe, it, expect, vi, afterEach } from 'vitest';
import { boot, render } from '../main.js';

afterEach(() => {
    vi.unstubAllGlobals();
});

/**
 * Stub global fetch with a single canned response.
 *
 * @param {*}      body
 * @param {number} status
 */
function stubFetch(body, status = 200) {
    vi.stubGlobal('fetch', vi.fn(async () => ({
        ok: status >= 200 && status < 300,
        status,
        json: async () => body,
    })));
}

describe('boot', () => {
    it('returns the payload when the API answers', async () => {
        // Arrange
        stubFetch({ application: '{{ appName }}', status: 'ok' });

        // Act
        const result = await boot();

        // Assert
        expect(result.ok).toBe(true);
        expect(result.data.status).toBe('ok');
    });

    it('reports the HTTP status when the API fails', async () => {
        // Arrange
        stubFetch({ message: 'boom' }, 503);

        // Act
        const result = await boot();

        // Assert — the status is what tells a developer where to look
        expect(result.ok).toBe(false);
        expect(result.text).toContain('503');
        expect(result.data).toBeNull();
    });
});

describe('render', () => {
    it('replaces the placeholder with the boot result and its payload', () => {
        // Arrange
        const target = document.createElement('div');
        target.textContent = 'Loading…';

        // Act
        render(target, { ok: true, text: 'Connected', data: { status: 'ok' } });

        // Assert
        expect(target.textContent).not.toContain('Loading…');
        expect(target.querySelector('.status-ok')).not.toBeNull();
        expect(target.querySelector('pre').textContent).toContain('"status": "ok"');
    });

    it('marks a failure visibly instead of leaving the page blank', () => {
        // Arrange
        const target = document.createElement('div');

        // Act
        render(target, { ok: false, text: 'Could not reach the API.', data: null });

        // Assert
        expect(target.querySelector('.status-error')).not.toBeNull();
        expect(target.querySelector('pre')).toBeNull();
        expect(target.textContent).toContain('Could not reach the API.');
    });
});
