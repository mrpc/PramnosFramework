/** The UI system this page runs under: `tailwind`, `bootstrap` or `plain-css`. */
export function system() {
    const declared = (typeof window !== 'undefined' && window.__PRAMNOS__ && window.__PRAMNOS__.ui) || 'tailwind';

    return Object.prototype.hasOwnProperty.call(MAPS, declared) ? declared : 'tailwind';
}

/**
 * The classes for one part, or several joined: `ui('btn', 'btn.sm')`.
 *
 * @param {...string} parts
 * @returns {string}
 */
export function ui(...parts) {
    const map = MAPS[system()];

    return parts.map((part) => map[part] ?? MAPS.tailwind[part] ?? '').filter(Boolean).join(' ');
}
