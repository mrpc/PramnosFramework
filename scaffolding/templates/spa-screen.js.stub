/**
 * {{ entityLabel }} — list, create, edit and delete, without a framework.
 *
 * Generated by `create:crud`. It talks to the API controller generated beside it,
 * which sits on the same model the MVC side uses: one domain object, two
 * controllers.
 *
 * The list endpoint is the model's `getApiList()` pipeline, so paging, search and
 * sorting happen on the server — the screen never loads the whole table to filter
 * it in the browser.
 *
 * `mount(target)` renders the screen into an element; the data helpers are
 * exported separately so both can be tested on their own. `main.js` finds this
 * screen through `screens/registry.js`, so it is reachable without editing the
 * shell.
 *
 * **Everything the API returns is written with `textContent` or `value`, never
 * into `innerHTML`.** A record's own text is untrusted — somebody typed it into
 * this form — and a generated file is the worst place to leave that decision to
 * whoever edits it next.
 */
import { api, ApiError } from '../lib/api.js';

const RESOURCE = '/{{ resource }}';
const KEY      = '{{ primaryKey }}';
const PER_PAGE = {{ perPage }};

/** Column descriptors, from the table itself: name, type, label, nullable. */
const FIELDS = {{ fieldsJson }};

/**
 * Which columns the list shows.
 *
 * The first few: a generated table with thirty columns is unreadable, and the
 * form below has all of them. Widen it by changing this line.
 */
const LIST_FIELDS = FIELDS.slice(0, {{ listColumnCount }});

/** The input type a column's SQL type deserves. */
function inputType(field) {
    const type = String(field.type ?? '').toLowerCase();

    if (/int|decimal|float|double|numeric/.test(type)) {
        return 'number';
    }
    if (/date|timestamp/.test(type)) {
        return type.includes('date') && !type.includes('time') ? 'date' : 'datetime-local';
    }
    if (/mail/.test(String(field.name))) {
        return 'email';
    }

    return 'text';
}

/**
 * Fetch one page of records.
 *
 * @param {{page?: number, perPage?: number, search?: string, sort?: string, dir?: string}} [options]
 * @returns {Promise<{rows: Array<object>, total: number, pages: number}>}
 */
export async function fetchPage({ page = 1, perPage = PER_PAGE, search = '', sort = '', dir = 'asc' } = {}) {
    // Parameter names are the ones the generated API controller reads, and the
    // envelope is what getApiList() returns: { data, pagination: {…} }.
    const params = new URLSearchParams({ page: String(page), limit: String(perPage) });
    if (search) {
        params.set('search', search);
    }
    if (sort) {
        params.set('sort', sort);
        params.set('dir', dir);
    }
    const result = await api.get(`${RESOURCE}?${params}`);
    const total  = result.pagination?.totalitems ?? 0;

    return {
        rows:  result.data ?? [],
        total,
        pages: Math.max(1, Math.ceil(total / perPage)),
    };
}

/**
 * Create or update a record, depending on whether it carries a primary key.
 *
 * @param {object} record
 */
export function saveRecord(record) {
    const id = record[KEY];

    return id ? api.put(`${RESOURCE}/${id}`, record) : api.post(RESOURCE, record);
}

/**
 * Delete a record by its primary key.
 *
 * @param {string|number} id
 */
export function deleteRecord(id) {
    return api.delete(`${RESOURCE}/${id}`);
}

/**
 * Render the screen into an element.
 *
 * @param {HTMLElement} target
 */
export function mount(target) {
    let page   = 1;
    let pages  = 1;
    let search = '';
    let sort   = '';
    let dir    = 'asc';

    target.textContent = '';

    const heading = document.createElement('h2');
    heading.textContent = '{{ entityLabel }}';

    const message = document.createElement('p');
    message.hidden = true;

    const table = document.createElement('table');
    const pager = document.createElement('p');
    pager.className = 'pager';

    const form = document.createElement('form');
    form.hidden = true;

    /** Show an error to the user rather than an empty screen. */
    const fail = (text) => {
        message.hidden = false;
        message.className = 'status status-error';
        message.textContent = text;
    };

    /** One header cell, which is also the sort control for its column. */
    const headerCell = (field) => {
        const th = document.createElement('th');
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = field.label + (sort === field.name ? (dir === 'asc' ? ' ▲' : ' ▼') : '');
        button.addEventListener('click', () => {
            dir  = sort === field.name && dir === 'asc' ? 'desc' : 'asc';
            sort = field.name;
            page = 1;           // a re-sort that kept the offset shows the wrong page
            draw();
        });
        th.append(button);

        return th;
    };

    /** Draw the current page. */
    const draw = async () => {
        try {
            const result = await fetchPage({ page, search, sort, dir });
            pages = result.pages;
            message.hidden = true;
            table.textContent = '';

            const head = document.createElement('thead');
            const headRow = document.createElement('tr');
            for (const field of LIST_FIELDS) {
                headRow.append(headerCell(field));
            }
            headRow.append(document.createElement('th'));
            head.append(headRow);
            table.append(head);

            const body = document.createElement('tbody');
            for (const row of result.rows) {
                const tr = document.createElement('tr');
                for (const field of LIST_FIELDS) {
                    const td = document.createElement('td');
                    // textContent, not innerHTML: this is somebody's typed input.
                    td.textContent = row[field.name] ?? '';
                    tr.append(td);
                }

                const actions = document.createElement('td');
                const edit    = document.createElement('button');
                edit.type = 'button';
                edit.textContent = 'Edit';
                edit.addEventListener('click', () => showForm(row));

                const del = document.createElement('button');
                del.type = 'button';
                del.textContent = 'Delete';
                del.addEventListener('click', async () => {
                    if (!confirm('Delete this record?')) {
                        return;
                    }
                    try {
                        await deleteRecord(row[KEY]);
                        await draw();
                    } catch {
                        fail('Could not delete.');
                    }
                });

                actions.append(edit, del);
                tr.append(actions);
                body.append(tr);
            }
            table.append(body);
            drawPager(result.total);
        } catch (err) {
            fail(err instanceof ApiError ? `Could not load: HTTP ${err.status}` : 'Could not reach the API.');
        }
    };

    /**
     * The pager — buttons, not a sentence.
     *
     * "Page 1 — 4,312 records" told the user there were more pages and gave them
     * no way to reach any of them.
     */
    const drawPager = (total) => {
        pager.textContent = '';

        const previous = document.createElement('button');
        previous.type = 'button';
        previous.textContent = '‹ Previous';
        previous.disabled = page <= 1;
        previous.addEventListener('click', () => { page -= 1; draw(); });

        const next = document.createElement('button');
        next.type = 'button';
        next.textContent = 'Next ›';
        next.disabled = page >= pages;
        next.addEventListener('click', () => { page += 1; draw(); });

        const where = document.createElement('span');
        where.textContent = ` Page ${page} of ${pages} — ${total} records `;

        pager.append(previous, where, next);
    };

    /** Show the create/edit form for a record. */
    const showForm = (record) => {
        form.textContent = '';
        form.hidden  = false;
        table.hidden = true;
        pager.hidden = true;

        for (const field of FIELDS) {
            if (field.name === KEY) {
                continue;       // the key is not something a form edits
            }

            const wrapper = document.createElement('p');
            const label   = document.createElement('label');
            label.textContent = field.label + ' ';

            const input = document.createElement('input');
            input.name  = field.name;
            input.type  = inputType(field);
            input.required = field.nullable === false;
            // value, not an interpolated attribute: a quote in the data would
            // otherwise end the attribute and the rest would be markup.
            input.value = record[field.name] ?? '';

            label.append(input);
            wrapper.append(label);
            form.append(wrapper);
        }

        const buttons = document.createElement('p');
        const save    = document.createElement('button');
        save.type = 'submit';
        save.textContent = 'Save';

        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.textContent = 'Cancel';
        cancel.addEventListener('click', () => {
            form.hidden  = true;
            table.hidden = false;
            pager.hidden = false;
        });

        buttons.append(save, cancel);
        form.append(buttons);

        form.onsubmit = async (event) => {
            event.preventDefault();
            const payload = { ...record };
            for (const field of FIELDS) {
                if (field.name !== KEY && form[field.name]) {
                    payload[field.name] = form[field.name].value;
                }
            }
            try {
                await saveRecord(payload);
                form.hidden  = true;
                table.hidden = false;
                pager.hidden = false;
                await draw();
            } catch (err) {
                fail(err instanceof ApiError && err.status === 422 ? 'Some fields are invalid.' : 'Could not save.');
            }
        };
    };

    const create = document.createElement('button');
    create.type = 'button';
    create.textContent = 'New';
    create.addEventListener('click', () => showForm({}));

    const searchForm = document.createElement('form');
    const searchInput = document.createElement('input');
    searchInput.name = 'q';
    searchInput.placeholder = 'Search';
    const searchButton = document.createElement('button');
    searchButton.type = 'submit';
    searchButton.textContent = 'Search';
    searchForm.append(searchInput, searchButton);
    searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        search = searchInput.value;
        page   = 1;             // a search that kept the offset would look empty
        draw();
    });

    target.append(heading, searchForm, create, message, form, table, pager);
    draw();
}
