/**
 * {{ entityLabel }} — list, create, edit and delete, without a framework.
 *
 * Generated by `create:crud`. It talks to the API controller generated beside
 * it, which sits on the same model the MVC side uses: one domain object, two
 * controllers.
 *
 * The list endpoint is the model's getApiList() pipeline, so paging and search
 * happen on the server — the screen never loads the whole table to filter it in
 * the browser.
 *
 * `mount(target)` renders the screen into an element and returns nothing; it is
 * exported separately from the data helpers so both can be tested on their own.
 */
import { api, ApiError } from '../lib/api.js';

const RESOURCE = '/{{ resource }}';
const KEY      = '{{ primaryKey }}';
const COLUMNS  = {{ columnsJson }};

/**
 * Fetch one page of records.
 *
 * @param {{page?: number, perPage?: number, search?: string}} [options]
 * @returns {Promise<{rows: Array<object>, total: number}>}
 */
export async function fetchPage({ page = 1, perPage = 20, search = '' } = {}) {
    // Parameter names are the ones the generated API controller reads, and the
    // envelope is what getApiList() returns: { data, pagination: {…} }.
    const params = new URLSearchParams({ page: String(page), limit: String(perPage) });
    if (search) {
        params.set('search', search);
    }
    const result = await api.get(`${RESOURCE}?${params}`);

    return {
        rows:  result.data ?? [],
        total: result.pagination?.totalitems ?? 0,
    };
}

/**
 * Create or update a record, depending on whether it carries a primary key.
 *
 * @param {object} record
 */
export function saveRecord(record) {
    const id = record[KEY];

    return id ? api.put(`${RESOURCE}/${id}`, record) : api.post(RESOURCE, record);
}

/**
 * Delete a record by its primary key.
 *
 * @param {string|number} id
 */
export function deleteRecord(id) {
    return api.delete(`${RESOURCE}/${id}`);
}

/**
 * Render the screen into an element.
 *
 * @param {HTMLElement} target
 */
export function mount(target) {
    let page   = 1;
    let search = '';

    const heading = document.createElement('h2');
    heading.textContent = '{{ entityLabel }}';

    const message = document.createElement('p');
    message.hidden = true;

    const table = document.createElement('table');
    const pager = document.createElement('p');

    const form = document.createElement('form');
    form.hidden = true;

    /** Show an error to the user rather than an empty screen. */
    const fail = (text) => {
        message.hidden = false;
        message.className = 'status status-error';
        message.textContent = text;
    };

    /** Draw the current page. */
    const draw = async () => {
        try {
            const { rows, total } = await fetchPage({ page, search });
            message.hidden = true;

            table.innerHTML = '<thead><tr>'
                + COLUMNS.map((c) => `<th>${c}</th>`).join('')
                + '<th></th></tr></thead>';

            const body = document.createElement('tbody');
            for (const row of rows) {
                const tr = document.createElement('tr');
                tr.innerHTML = COLUMNS.map((c) => `<td>${row[c] ?? ''}</td>`).join('');

                const actions = document.createElement('td');
                const edit    = document.createElement('button');
                edit.textContent = 'Edit';
                edit.addEventListener('click', () => showForm(row));

                const del = document.createElement('button');
                del.textContent = 'Delete';
                del.addEventListener('click', async () => {
                    if (!confirm('Delete this record?')) {
                        return;
                    }
                    try {
                        await deleteRecord(row[KEY]);
                        await draw();
                    } catch {
                        fail('Could not delete.');
                    }
                });

                actions.append(edit, del);
                tr.append(actions);
                body.append(tr);
            }
            table.append(body);
            pager.textContent = `Page ${page} — ${total} records`;
        } catch (err) {
            fail(err instanceof ApiError ? `Could not load: HTTP ${err.status}` : 'Could not reach the API.');
        }
    };

    /** Show the create/edit form for a record. */
    const showForm = (record) => {
        form.hidden  = false;
        table.hidden = true;
        form.innerHTML = COLUMNS
            .map((c) => `<p><label>${c} <input name="${c}" value="${record[c] ?? ''}"></label></p>`)
            .join('')
            + '<p><button type="submit">Save</button> <button type="button" data-cancel>Cancel</button></p>';

        form.querySelector('[data-cancel]').addEventListener('click', () => {
            form.hidden  = true;
            table.hidden = false;
        });

        form.onsubmit = async (event) => {
            event.preventDefault();
            const payload = { ...record };
            for (const column of COLUMNS) {
                payload[column] = form[column].value;
            }
            try {
                await saveRecord(payload);
                form.hidden  = true;
                table.hidden = false;
                await draw();
            } catch (err) {
                fail(err instanceof ApiError && err.status === 422 ? 'Some fields are invalid.' : 'Could not save.');
            }
        };
    };

    const create = document.createElement('button');
    create.textContent = 'New';
    create.addEventListener('click', () => showForm(Object.fromEntries(COLUMNS.map((c) => [c, '']))));

    const searchForm = document.createElement('form');
    searchForm.innerHTML = '<input name="q" placeholder="Search"><button type="submit">Search</button>';
    searchForm.addEventListener('submit', (event) => {
        event.preventDefault();
        search = searchForm.q.value;
        page   = 1; // a search that kept the offset would look empty
        draw();
    });

    target.append(heading, searchForm, create, message, form, table, pager);
    draw();
}
