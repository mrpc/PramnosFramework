<?php
/**
 * Single-page-application shell for {{ appName }}.
 *
 * A tiny page — deliberately NOT an MVC view (no theme, no getView()). It emits
 * the app-shell HTML and boots the JS client, which talks to the JSON API over
 * fetch(). The API is the contract; document it with `php {{ cliName }}.php api:docs`.
 *
 * Three asset modes are handled here, in order:
 *
 *   - A **running Vite dev server** writes {{ hotPath }} with its origin. While
 *     that file exists the shell loads the Vite client and the entry module
 *     from it, so you develop with HMR against the real backend by browsing
 *     this page — the Vite port itself serves no HTML.
 *
 *   - A Vite build writes {{ manifestPath }}; each entry carries a
 *     content-hashed filename, which IS the cache-buster. Read it and emit the
 *     hashed URLs (plus any CSS the entry imports).
 *   - With no build (or before the first one), fall back to stamping the plain
 *     asset paths with their modification time (app.js?v=…), so a deploy still
 *     busts the cache without a toolchain.
 */

$root = __DIR__;

// The framework's API layer requires an `apiKey` header on every request, and
// it accepts the md5 of the site URL as the key for the site's own front end
// (Api::checkApiKey). Deriving it here — rather than hard-coding one — means the
// SPA authenticates as this application wherever it is deployed. Only the
// autoloader is required, for getUrl(); the app itself is not booted.
require dirname($root) . '/vendor/autoload.php';

$siteUrl = getUrl();
// app/app.php is a plain array: read for `scaffold_theme`, so the shared components
// draw with the system `project:switch-ui` last set, without booting the app.
$appConfig = is_file(dirname($root) . '/app/app.php') ? include dirname($root) . '/app/app.php' : [];
$runtime = [
    'appName'   => '{{ appName }}',
    'apiPrefix' => '{{ apiPrefix }}',
    'apiKey'    => md5(str_replace('/api/', '/', $siteUrl)),
    'features'  => ['auth' => {{ hasAuth }}, 'help' => {{ hasHelp }}],
    'ui'        => is_array($appConfig) ? (string) ($appConfig['scaffold_theme'] ?? 'tailwind') : 'tailwind',
    // Published so the debug panel can print it next to the current path: a
    // router mounted somewhere the URL does not start with resolves every deep
    // link to the home screen, and nothing on screen says why.
    'routerBase' => '{{ routerBase }}',
];

// Realtime, where the application serves a socket (broadcast:serve, or Pusher): the tag pf-utils.js
// connects from, as Document prints it on a server page. Its private channels are signed by the
// API's own /broadcasting/auth, which takes the API key and token lib/live.js hands it — the shell
// boots no application to ask for the site's address. Null, and nothing loaded, with no socket.
$realtime = \Pramnos\Broadcasting\RealtimeConfig::forShell(
    $siteUrl . ltrim('{{ apiPrefix }}', '/') . '/broadcasting/auth',
    is_array($appConfig) && is_array($appConfig['broadcasting'] ?? null) ? $appConfig['broadcasting'] : []
);

// The first paint: grey shapes where the page is about to be — a bar, a title, a row of cards and
// a panel, as components/Skeleton.svelte draws them — before any JavaScript, the stylesheet
// already loaded. Sized inline, so no build has to find these classes; the shape is the UI
// system's (daisyUI's `skeleton`, or the theme's `pf-ui-skeleton`). main.js empties #app.
$bone = static function (string $style) use ($runtime): string {
    return '<div class="' . ($runtime['ui'] === 'tailwind' ? 'skeleton' : 'pf-ui-skeleton') . '" style="' . $style . '"></div>';
};

/** Stamp an asset URL with the file's mtime — the build-less cache-buster. */
$stamp = static function (string $path) use ($root): string {
    $mtime = @filemtime($root . '/' . ltrim($path, '/')) ?: 0;
    return htmlspecialchars($path . '?v=' . $mtime, ENT_QUOTES);
};

$scripts = [];
$styles  = [];

// 1. Dev server running? Load everything from it; Vite injects the CSS itself.
$hotFile = $root . '/{{ hotPath }}';
if (is_file($hotFile)) {
    $origin  = rtrim(trim((string) file_get_contents($hotFile)), '/');
    // Both URLs carry the configured base — the dev server serves everything,
    // its own client included, underneath it.
    $scripts = [
        $origin . '{{ assetBase }}@vite/client',
        $origin . '{{ assetBase }}{{ entry }}',
    ];
}

// 2. A build wrote a manifest? Use its content-hashed filenames.
$manifestFile = $root . '/{{ manifestPath }}';
if ($scripts === [] && is_file($manifestFile)) {
    $manifest = json_decode((string) file_get_contents($manifestFile), true);
    $entry    = is_array($manifest) ? ($manifest['{{ entryKey }}'] ?? null) : null;
    if (is_array($entry) && isset($entry['file'])) {
        $scripts[] = '{{ assetBase }}' . $entry['file'];
        foreach ($entry['css'] ?? [] as $css) {
            $styles[] = '{{ assetBase }}' . $css;
        }
    }
}

// 3. Neither: serve the sources as they are, stamped with their mtime.
if ($scripts === []) {
    $styles  = [$stamp('{{ fallbackCss }}')];
    $scripts = [$stamp('{{ fallbackJs }}')];
}

// The shell itself must always be revalidated, or a deploy ships new assets
// behind an old HTML document that never references them.
header('Cache-Control: no-cache, must-revalidate');
?>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ appName }}</title>
<?php if ($realtime !== null): ?>
    <meta name="pf-realtime" content="<?php echo htmlspecialchars((string) json_encode($realtime, JSON_UNESCAPED_SLASHES), ENT_QUOTES); ?>">
<?php endif; ?>
<?php foreach ($styles as $style): ?>
    <link rel="stylesheet" href="<?php echo $style; ?>">
<?php endforeach; ?>
</head>
<body>
    <div id="app">
        <div style="padding:1rem 1.5rem;display:flex;flex-direction:column;gap:1rem" role="status" aria-label="Loading" aria-busy="true">
            <?php echo $bone('height:2.5rem;width:100%'); ?>
            <?php echo $bone('height:2rem;width:12rem'); ?>
            <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(10rem,1fr));gap:1rem">
                <?php echo $bone('height:6rem') . $bone('height:6rem') . $bone('height:6rem') . $bone('height:6rem'); ?>
            </div>
            <?php echo $bone('height:16rem;width:100%'); ?>
        </div>
    </div>
    <script>window.__PRAMNOS__ = <?php echo json_encode($runtime, JSON_UNESCAPED_SLASHES | JSON_HEX_TAG); ?>;</script>
<?php if ($realtime !== null && is_file($root . '/assets/js/pf-utils.js')): ?>
    <script src="<?php echo htmlspecialchars($siteUrl, ENT_QUOTES) . $stamp('assets/js/pf-utils.js'); ?>" defer></script>
<?php endif; ?>
<?php foreach ($scripts as $script): ?>
    <script type="module" src="<?php echo $script; ?>"></script>
<?php endforeach; ?>
{{ cookieConsentScript }}{{ serviceWorkerRegistration }}</body>
</html>
