<script>
    import { api } from '../lib/api.js';
    import { t } from '../lib/i18n.svelte.js';

    /**
     * The help page for the screen on show — the SPA's side panel.
     *
     * The front end of `Pramnos\Assist\HelpApi`: it asks `GET /help/screen` for the screen's
     * page whenever the screen changes, and shows a Help button only where there is one. The
     * panel draws the page the server drew; a link to another page (`?help=<slug>`) opens it in
     * place, and its pictures arrive inline, so nothing here needs a second request per image.
     *
     * The site's pages unless `level` is `admin`, which the server grants only to whoever may
     * open the administration's Help screen.
     */

    /**
     * The button is the application's to change, in three degrees:
     *   - `compact` — a small round, muted "?" instead of the word;
     *   - `buttonClass` — the built-in button with these classes instead;
     *   - `button` — a snippet drawn instead, given `open()` and the page found (`{slug, title}`).
     * Any of them is drawn only where the screen has a page.
     *
     * @type {{ screen: string, action?: string, level?: string, compact?: boolean, buttonClass?: string, button?: import('svelte').Snippet<[() => void, { slug: string, title: string }]> }}
     */
    let { screen, action = '', level = '', compact = false, buttonClass = '', button } = $props();

    /** The built-in button's classes. */
    const classes = $derived(buttonClass || (compact
        ? 'btn btn-ghost btn-sm btn-circle opacity-60 hover:opacity-100'
        : 'btn btn-ghost btn-sm'));

    function openPanel() {
        open = true;
    }

    let page   = $state(null);
    let open   = $state(false);
    let failed = $state(false);

    /**
     * The page out of the API's answer, `{status, data: {…}}`: `lib/api.js` hands the payload over
     * as it came. Without the unwrap the panel drew an empty title over an empty page.
     */
    function unwrap(found) {
        return found?.data ?? found ?? null;
    }

    /** The request's query: the level only when one was asked for. */
    function query(extra) {
        return level ? { ...extra, level } : extra;
    }

    // The screen's page, again whenever the screen changes. A 404 is the normal answer for a
    // screen without help: no button, and no error.
    $effect(() => {
        const asked = screen;
        page = null;
        open = false;
        if (!asked) {
            return;
        }
        api.get('/help/screen', query({ screen: asked, action }))
            .then((found) => { if (asked === screen) { page = unwrap(found); } })
            .catch(() => { if (asked === screen) { page = null; } });
    });

    /** Another page, by name, in place of the one on show. */
    async function openPage(slug) {
        failed = false;
        try {
            page = unwrap(await api.get('/help/page', query({ p: slug })));
        } catch {
            failed = true;
        }
    }

    /** A click on a link between pages opens the page here, not as an address. */
    function onClick(event) {
        const link = event.target.closest?.('a[href^="?help="]');
        if (!link) {
            return;
        }
        event.preventDefault();
        openPage(decodeURIComponent(link.getAttribute('href').slice('?help='.length)));
    }

    function onKeydown(event) {
        if (event.key === 'Escape') {
            open = false;
        }
    }
</script>

<svelte:window onkeydown={onKeydown} />

{#if page}
    {#if button}
        {@render button(openPanel, { slug: page.slug, title: page.title })}
    {:else if compact}
        <button class={classes} type="button" aria-haspopup="dialog" aria-label={t('Help')} title={t('Help')} onclick={openPanel}>
            <svg xmlns="http://www.w3.org/2000/svg" class="size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.5 9a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6"/><path d="M12 17h.01"/></svg>
        </button>
    {:else}
        <button class={classes} type="button" aria-haspopup="dialog" onclick={openPanel}>
            {t('Help')}
        </button>
    {/if}
{/if}

{#if open && page}
    <div class="fixed inset-y-0 right-0 z-50 flex w-full max-w-md flex-col bg-base-100 shadow-xl" role="dialog" aria-label={page.title}>
        <header class="flex items-center gap-2 border-b border-base-300 p-3">
            <strong class="flex-1 truncate">{page.title}</strong>
            <button class="btn btn-ghost btn-sm" type="button" aria-label={t('Close')} onclick={() => { open = false; }}>✕</button>
        </header>
        <!-- svelte-ignore a11y_click_events_have_key_events, a11y_no_static_element_interactions -->
        <div class="prose max-w-none flex-1 overflow-auto p-4" onclick={onClick}>
            {#if failed}
                <p class="text-error">{t('That help page could not be opened.')}</p>
            {/if}
            <!-- Drawn by the server's Markdown renderer, which escapes before it draws. -->
            {@html page.html}
        </div>
    </div>
{/if}
