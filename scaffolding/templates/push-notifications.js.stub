/*
 * Turning browser notifications on, from a page.
 *
 * The server half of web push — the key pair, the subscription table, the channel, the three
 * endpoints — is complete and reachable without any of this. What it cannot do is **ask**:
 * `Notification.requestPermission()` and `PushManager.subscribe()` only exist in a page, and
 * only mean anything when a person has just clicked something.
 *
 * Without this file an installation has every server-side piece working and no subscriptions,
 * for ever, with nothing anywhere saying why.
 *
 * Drop a button on any page and this wires it up:
 *
 *     <button data-push-subscribe hidden>Turn on notifications</button>
 *     <span data-push-state></span>
 *
 * And, for the soft prompt that reaches somebody who never opens a settings screen:
 *
 *     <div data-push-invite hidden>
 *         … <button data-push-subscribe>Turn on</button> <button data-push-later>Not now</button>
 *     </div>
 *
 * Its addresses are worked out from where it is loaded, `assets/js/push.js`; a page that loads it
 * from elsewhere says where the site is with `<script src="…" data-push-base="/myapp/">`.
 *
 * @app {{APP_NAME}}
 */
(function () {
    'use strict';

    /*
     * Where this site is: `data-push-base` on the script tag, or two folders above the script
     * itself (`assets/js/push.js`). The site may live in a folder, and `/push/key` from the host's
     * root would then be another site's address.
     */
    var script = document.currentScript;

    /*
     * An address resolved against another, as `{href, origin}`.
     *
     * Not `new URL()` alone: a page that declares a global `var URL = "…"` — legacy pages do, for
     * their own address — has replaced the constructor before this script runs, and every call
     * threw "URL is not a constructor". Then an anchor resolves it, as the browser always could.
     */
    var Url = typeof window.URL === 'function' ? window.URL : null;

    function resolve(path, against) {
        if (Url) {
            var url = new Url(path, against);

            return { href: url.href, origin: url.origin };
        }
        var a = document.createElement('a');
        a.href = against;
        var root = a.protocol + '//' + a.host;
        var dir = a.href.replace(/[?#].*$/, '').replace(/[^/]*$/, '');
        a.href = /^[a-z][a-z0-9+.-]*:|^\/\//i.test(path) ? path : (path.charAt(0) === '/' ? root + path : dir + path);

        return { href: a.href, origin: a.protocol + '//' + a.host };
    }

    var base = resolve(
        (script && script.getAttribute('data-push-base')) || (script && script.src ? resolve('../../', script.src).href : '/'),
        window.location.href
    ).href;

    function sitePath(path) {
        return resolve(path, base).href;
    }

    /*
     * The site's own worker — the one at the web root, whose scope is the whole site.
     *
     * Not `serviceWorker.ready` alone: a page with a worker of its own (the conversations, which
     * keep themselves for when the server is down) gets that one from `ready`, and subscriptions
     * are per registration — this page would say notifications are off while the site's worker
     * is subscribed, and a subscribe would hand the server an endpoint whose worker shows nothing.
     */
    function registration() {
        if (typeof navigator.serviceWorker.getRegistration !== 'function') {
            return navigator.serviceWorker.ready;
        }

        return navigator.serviceWorker.getRegistration(base).then(function (found) {
            return found || navigator.serviceWorker.ready;
        });
    }

    /*
     * The page's words: `data-push-words` on the script tag, a JSON object from each English
     * sentence below to the page's language — the themes fill it with
     * `\Pramnos\Push\BrowserScript::words()`. A sentence it does not have is said in English.
     */
    var words = {};
    try {
        words = JSON.parse((script && script.getAttribute('data-push-words')) || '{}') || {};
    } catch (e) {
        words = {};
    }

    function w(sentence) {
        return typeof words[sentence] === 'string' && words[sentence] !== '' ? words[sentence] : sentence;
    }

    /*
     * The session's token, for the two calls that change the account: the page's
     * `<meta name="csrf">`, or `data-push-token` on the script tag. The server refuses a subscribe
     * or unsubscribe from another page that the session cookie reaches without it.
     */
    function token() {
        var meta = document.querySelector('meta[name="csrf"]');

        return (script && script.getAttribute('data-push-token')) || (meta && (meta.content || meta.getAttribute('content'))) || '';
    }

    /*
     * A notification tapped while a tab of this site was open: the worker focused that tab and
     * says where the notification leads. Without this the tab came forward and stayed where it
     * was. A single-page application that routes for itself cancels `pf:notification-click`;
     * otherwise the page goes there — only within this site, whatever the payload said.
     */
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.addEventListener('message', function (event) {
            var data = event.data || {};

            if (data.type !== 'notification-click' || typeof data.url !== 'string') {
                return;
            }

            var target = resolve(data.url, window.location.href);
            var go = new CustomEvent('pf:notification-click', { detail: { url: target.href }, cancelable: true });

            if (target.origin === window.location.origin && window.dispatchEvent(go)) {
                window.location.assign(target.href);
            }
        });
    }

    /*
     * Every control on the page, not the first one.
     *
     * A page can offer this twice and the settings screen does: the soft prompt lives in the
     * footer on every signed-in page, and the privacy screen has a permanent switch of its own.
     * With `querySelector` the two were on the same page and only one of them was wired — the
     * one earlier in the document — so the invitation's button did nothing when pressed, which
     * is worse than not offering it.
     */
    var buttons = Array.prototype.slice.call(
        document.querySelectorAll('[data-push-subscribe]')
    );
    var states = Array.prototype.slice.call(document.querySelectorAll('[data-push-state]'));
    var invite = document.querySelector('[data-push-invite]');
    var later  = document.querySelector('[data-push-later]');

    if (buttons.length === 0) {
        return;
    }

    function show() {
        buttons.forEach(function (button) {
            button.hidden = false;
        });
    }

    /*
     * How long "not now" lasts.
     *
     * A soft prompt that comes back on the next page load is a nag, and a nag is answered with
     * the browser's own block button — which is the one answer this feature cannot recover
     * from. Thirty days, and only for the invitation: the settings screen is always there.
     */
    var LATER_DAYS = 30;
    var LATER_KEY  = 'pf.push.later';

    function askedRecently() {
        try {
            var until = parseInt(window.localStorage.getItem(LATER_KEY) || '0', 10);

            return until > Date.now();
        } catch (e) {
            // Private windows and blocked site data throw on access rather than returning null.
            return false;
        }
    }

    function rememberLater() {
        try {
            window.localStorage.setItem(LATER_KEY, String(Date.now() + LATER_DAYS * 86400000));
        } catch (e) {
            // Nothing to do: the invitation reappears next time, which is the safe failure.
        }
    }

    if (later) {
        later.addEventListener('click', function () {
            rememberLater();

            if (invite) {
                invite.hidden = true;
            }
        });
    }

    /*
     * Say why, not just "unavailable".
     *
     * Every one of these is a different problem for a different person: iOS needs the site on
     * the home screen, a plain-HTTP host needs a certificate, and a denied permission needs the
     * visitor to go into their own browser settings — which nothing on this page can do for
     * them.
     */
    function unsupported() {
        if (!('serviceWorker' in navigator)) {
            return 'This browser has no service worker, so it cannot receive notifications.';
        }

        if (!('PushManager' in window)) {
            // iOS Safari reaches here in a normal tab: it supports push only for a site added
            // to the home screen, and there is no way to ask for it from the browser.
            return 'This browser cannot receive push notifications. On iPhone and iPad, add this '
                + 'site to the home screen first.';
        }

        if (!window.isSecureContext) {
            return 'Notifications need a secure connection (https).';
        }

        return null;
    }

    function say(message, disabled) {
        states.forEach(function (state) {
            state.textContent = message === '' ? '' : w(message);
        });

        buttons.forEach(function (button) {
            button.disabled = Boolean(disabled);
        });
    }

    var reason = unsupported();

    if (reason) {
        show();
        say(reason, true);

        return;
    }

    if (Notification.permission === 'denied') {
        /*
         * A denial is close to permanent and this page cannot undo it.
         *
         * The browser will not ask again — the visitor has to change it in the site settings
         * themselves — so the honest thing is to say so rather than leave a button that does
         * nothing when pressed.
         */
        show();
        say('Notifications are blocked for this site. Turn them back on in your browser\'s site '
            + 'settings.', true);

        return;
    }

    function key() {
        return fetch(sitePath('push/key'), { credentials: 'include' })
            .then(function (response) {
                if (!response.ok) {
                    // 503: the installation has no VAPID pair. Nothing the visitor can do.
                    throw new Error('no-key');
                }

                return response.json();
            })
            .then(function (body) {
                return body.publicKey;
            });
    }

    function subscribe() {
        say('Asking…', true);

        /*
         * Permission first, and only from this click.
         *
         * A prompt that appears on page load is denied by most people and, in Chrome, is
         * suppressed outright for visitors who habitually deny them — so the one chance an
         * application gets is spent before anybody has decided anything.
         */
        return Notification.requestPermission()
            .then(function (permission) {
                if (permission !== 'granted') {
                    /*
                     * Asked and refused. The invitation must not come back: the browser will
                     * not ask again either, and repeating the offer is how a "not now" becomes
                     * a permanent block.
                     */
                    rememberLater();

                    if (invite) {
                        invite.hidden = true;
                    }

                    say('Not turned on.', false);

                    return null;
                }

                return Promise.all([registration(), key()]);
            })
            .then(function (both) {
                if (!both) {
                    return null;
                }

                return both[0].pushManager.subscribe({
                    // Not optional in Chrome: a push that shows no notification is treated as an
                    // abuse of the wake-up, and the browser shows its own "this site has been
                    // updated in the background" instead.
                    userVisibleOnly: true,
                    applicationServerKey: both[1]
                });
            })
            .then(function (subscription) {
                if (!subscription) {
                    return null;
                }

                return fetch(sitePath('push/subscribe'), {
                    method: 'POST',
                    credentials: 'include',
                    headers: { 'Content-Type': 'application/json', 'X-CSRF-Token': token() },
                    body: JSON.stringify(subscription.toJSON())
                });
            })
            .then(function (response) {
                if (!response) {
                    return;
                }

                if (response.ok) {
                    say('Notifications are on for this browser.', true);

                    if (invite) {
                        invite.hidden = true;
                    }

                    return;
                }

                // 401 is the common one: the endpoint stores a subscription against an account,
                // and there is nobody to notify without a session.
                say(response.status === 401
                    ? 'Sign in first, then turn notifications on.'
                    : 'That did not work. Try again.', false);
            })
            .catch(function (error) {
                say(error && error.message === 'no-key'
                    ? 'Notifications are not set up on this server yet.'
                    : 'That did not work. Try again.', false);
            });
    }

    show();
    buttons.forEach(function (button) {
        button.addEventListener('click', subscribe);
    });

    /*
     * The invitation, and the four conditions on showing it.
     *
     * This is a **soft prompt**: it is not the browser's permission dialogue, it is an offer to
     * open it. That distinction is the whole design. A real prompt on page load is denied by
     * most people, and Chrome suppresses it outright for visitors who habitually deny — so an
     * application gets one chance and spends it before anybody has decided anything.
     *
     * Shown only when it can lead somewhere: push is supported, permission has never been
     * asked for, this browser is not already subscribed, and the visitor has not said "not now"
     * recently.
     */
    function offer(subscription) {
        if (!invite) {
            return;
        }

        invite.hidden = !(
            Notification.permission === 'default'
            && !subscription
            && !askedRecently()
        );
    }

    /*
     * Say what the state already is.
     *
     * Permission granted does not mean *this* browser is subscribed — the site data may have
     * been cleared, or the subscription may have been revoked from the account. The
     * registration is the only thing that knows.
     */
    registration()
        .then(function (found) {
            return found.pushManager.getSubscription();
        })
        .then(function (subscription) {
            if (subscription) {
                say('Notifications are on for this browser.', true);
            } else {
                say('', false);
            }

            offer(subscription);
        })
        .catch(function () {
            say('', false);
            offer(null);
        });
}());
