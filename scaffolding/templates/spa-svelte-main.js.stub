/**
 * Entry point of the {{ appName }} SPA.
 *
 * Mounts the root Svelte component into the #app element emitted by the PHP
 * shell ({{ webRoot }}/{{ shellFile }}). Svelte 5 mounts with `mount()` rather than
 * `new App()`.
 */
import { mount } from 'svelte';
import './app.css';
import App from './App.svelte';

const target = document.getElementById('app');
target.textContent = '';

export default mount(App, { target });
