<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>{{ title }}</title>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <style>body { margin: 0; }</style>
</head>
<body>
  <!--
    API documentation viewer, generated by `pramnos api:docs --viewer=scalar`.

    Renders the sibling OpenAPI spec with Scalar, pinned to one release: an unpinned
    address follows every release without a word. No telemetry, no AI agent, no
    proxy (Scalar's proxy would route "Test Request" calls through their server),
    and no fonts from Scalar's server. Regenerate with `pramnos api:docs --viewer=scalar`.
  -->
  <div id="app"></div>
  <script src="https://cdn.jsdelivr.net/npm/@scalar/api-reference@1.75.1/dist/browser/standalone.js"></script>
  <script>
    Scalar.createApiReference('#app', {
      sources: {{ sources }},
      persistAuth: true,
      telemetry: false,
      agent: { disabled: true },
      showDeveloperTools: 'never',
      withDefaultFonts: false
    });
  </script>
</body>
</html>
