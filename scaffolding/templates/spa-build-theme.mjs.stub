#!/usr/bin/env node
/**
 * Generate the daisyUI palette from this project's server-rendered theme.
 *
 * The two halves of the application must not look like two products, so neither
 * half chooses colours. `app/themes/theme.css` declares them once, in daisyUI's own
 * format, and this copies those blocks in — no mapping, no guessing, because the
 * names already match.
 *
 * A project scaffolded before that file existed falls back to reading the
 * server-rendered theme's `:root` custom properties and mapping what it
 * recognises. That path guesses: it knows `--primary-color`, and invents the
 * rest. `pramnos theme:build` and an `app/themes/theme.css` are how a project stops
 * guessing.
 *
 * This runs from `prebuild` and `predev`, so changing a colour in the theme
 * reaches the SPA on the next build — which is when the CSS is rebuilt anyway.
 * Doing it here rather than in the PHP shell keeps it off the request path
 * entirely: no per-request work, no inline <style> for a CSP to block.
 *
 * It is the single implementation of the mapping. Nothing else derives these
 * values, so there is nothing for it to drift from.
 */
import { readFileSync, writeFileSync, existsSync } from 'node:fs';
import { dirname, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';

const root    = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const THEME   = resolve(root, '{{ themePath }}');
const PALETTE = resolve(root, '{{ palettePath }}');
const OUT     = resolve(root, '{{ themeOutput }}');

/**
 * The colour this project's UI framework actually paints with, used when the
 * theme declares no custom properties of its own. daisyUI's default purple
 * would match nothing on the server-rendered side.
 */
const FALLBACK_PRIMARY = '{{ fallbackPrimary }}';

/**
 * Read the `:root` custom properties of a stylesheet.
 *
 * @param {string} css
 * @returns {Record<string, string>}
 */
function rootVariables(css) {
    const block = css.match(/:root\s*\{([\s\S]*?)\}/);
    if (!block) {
        return {};
    }

    const vars = {};
    for (const [, name, value] of block[1].matchAll(/(--[\w-]+)\s*:\s*([^;]+);/g)) {
        const trimmed = value.trim();
        // Only flat colours map onto daisyUI tokens; a gradient or a shadow is
        // a different kind of value and would produce nonsense.
        if (!trimmed.includes('gradient') && !trimmed.includes(' 0 ')) {
            vars[name] = trimmed;
        }
    }

    return vars;
}

/**
 * Every `@plugin "daisyui/theme"` block in the project's palette.
 *
 * Emitted as plain custom properties rather than as `@plugin` blocks: this file is
 * imported by the SPA's stylesheet, and the plugin has already run by then.
 *
 * @param {string} css
 * @returns {string} The declarations, or '' when the file declares no theme
 */
function paletteBlocks(css) {
    let out = '';

    for (const [, body] of css.matchAll(/@plugin\s+["']daisyui\/theme["']\s*\{([^}]*)\}/g)) {
        let name = '';
        let isDefault = false;
        let prefersDark = false;
        const declarations = [];

        for (const line of body.split(';')) {
            const trimmed = line.trim();
            if (!trimmed.includes(':')) { continue; }
            const key = trimmed.slice(0, trimmed.indexOf(':')).trim();
            const value = trimmed.slice(trimmed.indexOf(':') + 1).trim().replace(/^["']|["']$/g, '');

            if (key === 'name') { name = value; continue; }
            if (key === 'default') { isDefault = value === '' || value === 'true'; continue; }
            if (key === 'prefersdark') { prefersDark = value === '' || value === 'true'; continue; }
            declarations.push(`    ${key}: ${value};`);
        }

        if (!name || declarations.length === 0) { continue; }

        // Doubled, for the same reason as below: this file is imported first, so
        // equal specificity would let daisyUI's own defaults win on order.
        const selectors = [`[data-theme="${name}"]:root`];
        if (isDefault) { selectors.unshift(':root:root'); }
        out += `${selectors.join(',\n')} {\n${declarations.join('\n')}\n}\n\n`;

        if (prefersDark) {
            out += `@media (prefers-color-scheme: dark) {\n`
                + `    :root:root:not([data-theme]) {\n`
                + declarations.map((d) => `    ${d}`).join('\n')
                + `\n    }\n}\n\n`;
        }
    }

    return out;
}

const paletteExists = existsSync(PALETTE);
const blocks = paletteExists ? paletteBlocks(readFileSync(PALETTE, 'utf8')) : '';

const themeExists = existsSync(THEME);
const vars = themeExists ? rootVariables(readFileSync(THEME, 'utf8')) : {};
const source = blocks
    ? '{{ palettePath }}'
    : (themeExists
        ? '{{ themePath }}' + (Object.keys(vars).length ? '' : ' — no custom properties, using the framework palette')
        : '{{ themePath }} (not found — using the framework palette)');

const palette = {
    '--color-primary': vars['--primary-color'] ?? FALLBACK_PRIMARY,
    '--color-primary-content': '#ffffff',
    '--color-base-100': vars['--white'] ?? '#ffffff',
    '--color-base-200': '#f8fafc',
    '--color-base-300': '#e2e8f0',
    '--color-base-content': vars['--text-main'] ?? '#1e293b',
    '--color-neutral': vars['--text-muted'] ?? '#64748b',
    '--color-neutral-content': '#ffffff',
    '--radius-box': '0.75rem',
    '--radius-field': '0.5rem',
};

const css = `/**
 * GENERATED — do not edit.
 *
 * Written by scripts/build-theme.mjs from the project's server-rendered theme,
 * on every build and every dev-server start. Change a colour in the theme, not
 * here; anything written here is overwritten.
 *
 * Source: ${source}
 *
 * The selector is doubled on purpose. CSS requires \`@import\` before other
 * rules, so this file is emitted before daisyUI's own theme, and equal
 * specificity would let daisyUI's defaults win on order.
 */
${blocks || `:root:root {
${Object.entries(palette).map(([name, value]) => `    ${name}: ${value};`).join('\n')}
}`}

:root:root {
    --font-sans: {{ fontFamily }};
}

body {
    font-family: var(--font-sans);
}
`;

writeFileSync(OUT, css);

const derived = Boolean(blocks) || (themeExists && Object.keys(vars).length > 0);

if (derived) {
    console.log(`theme: palette written to {{ themeOutput }} from ${source}`);
} else {
    // A warning rather than a log line, and it says what to do. Reported by a
    // project whose layout puts the theme elsewhere: the build succeeded, the
    // palette fell back, and the application shipped in somebody else's brand
    // colour — with an informational line that read exactly like the success case.
    console.warn(
        `\n\x1b[33m⚠ theme: no palette found — the SPA will use the framework's `
        + `colours, not this project's.\x1b[0m\n`
        + `  Looked in: {{ themePath }}\n`
        + (themeExists
            ? `  It exists but declares no \`:root\` custom properties to map.\n`
            : `  It does not exist.\n`)
        + `  Fix: declare the palette in {{ palettePath }} — the format daisyUI's `
        + `theme generator emits — and run \`pramnos theme:build\`. Or point THEME in `
        + `scripts/build-theme.mjs at this project's stylesheet.\n`
    );
}
