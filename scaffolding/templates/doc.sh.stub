#!/usr/bin/env bash
# Generate API documentation (OpenAPI JSON + RapiDoc viewer).
#
# By default this runs inside the Docker "app" container, where Node/npm are
# installed — no local Node needed. Pass --host (or --local) to run directly on
# the host machine instead (requires Node + npm installed locally).
#
#   bash scripts/doc.sh            # inside Docker (default)
#   bash scripts/doc.sh --host     # on the host machine
#
# Run from the project root (or via `npm run docs`).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SELF="${SCRIPT_DIR}/$(basename "${BASH_SOURCE[0]}")"
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
cd "${PROJECT_ROOT}"

RUN_ON_HOST=0
for arg in "$@"; do
  case "$arg" in
    --host|--local) RUN_ON_HOST=1 ;;
    -h|--help)
      grep '^#' "${SELF}" | sed 's/^# \{0,1\}//'
      exit 0
      ;;
    *) echo "Unknown option: $arg (use --host to run on the host machine)" >&2; exit 2 ;;
  esac
done

# Generate the OpenAPI/RapiDoc output. The generator handles an empty API
# gracefully (no annotated controllers yet) and still includes any OAuth
# overrides. Runs inside the container by default, or on the host with --host.
GEN_CMD='npm run docs:build'

if [ "$RUN_ON_HOST" -eq 1 ]; then
  echo "Generating API documentation on the host machine..."
  if ! command -v npm >/dev/null 2>&1; then
    echo "ERROR: npm is not installed on the host. Install Node.js, or omit --host to run inside Docker." >&2
    exit 1
  fi
  [ -d node_modules ] || { echo "Installing Node dependencies..."; npm install; }
  sh -c "$GEN_CMD"
else
  echo "Generating API documentation inside the Docker app container..."
  # Prefer the v2 plugin syntax, fall back to the legacy binary.
  if docker compose version >/dev/null 2>&1; then
    DC="docker compose"
  elif command -v docker-compose >/dev/null 2>&1; then
    DC="docker-compose"
  else
    echo "ERROR: docker compose is not available. Start Docker, or run on the host with: bash scripts/doc.sh --host" >&2
    exit 1
  fi
  # -u www-data: the image maps that user to the host user's ids, so
  # node_modules/ and the generated docs stay owned by the developer. Running
  # this as root would create a root-owned node_modules that every later npm
  # command (the SPA build, ./dockernpm) then fails on with EACCES. HOME must be
  # writable for npm's cache; www-data's is not.
  DC_RUN="$DC exec -T -u www-data -e HOME=/tmp app"
  $DC_RUN sh -c '[ -d node_modules ] || npm install'
  $DC_RUN sh -c "$GEN_CMD"
fi

echo "Done. Documentation available at www/api/docs/index.html"
