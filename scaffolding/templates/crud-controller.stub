    /**
     * AJAX data endpoint for the server-side DataTable — returns JSON, never
     * the theme.
     *
     * The DataTable posts its paging/search/order parameters to this URL;
     * Datasource::getList() reads a column's own search box and a header-click
     * sort by indexing straight into the field list with the browser's own
     * column number — it has no notion of a field that is not a declared
     * column. So the field list here is exactly the addColumn order in
     * display(), column for column, and the primary key (needed to build each
     * row's link, but never shown as its own column) is appended *last*,
     * past every index the browser ever sends a column for, rather than put
     * first where it would have pushed every real column one index ahead of
     * what the browser actually asked for. The primary key is read off each
     * row by that known position, then dropped, and an Actions cell is
     * appended.
     */
    public function data(): void
    {
        \Pramnos\Framework\Factory::getDocument('json');

        $fields = [{{ dataFields }}];
        $result = \Pramnos\Html\Datatable\Datasource::getList(
            '{{ tableName }}',
            $fields,
            false
        );

        $dataKey = array_key_exists('data', $result) ? 'data' : 'aaData';
        foreach ($result[$dataKey] as &$row) {
            // Not array_pop(): Datasource::getList() appends a 'DT_RowId'
            // *string* key after every numeric one, so the actual last element
            // is that copy of $row[0], not the primary key — read by this
            // fixed, known position instead.
            $id      = (int) $row[{{ pkFieldIndex }}];
            unset($row[{{ pkFieldIndex }}]);
            $showUrl = sURL . '{{ className }}/show/' . $id;

            // The first visible column opens the record. A row whose only way in is
            // the last cell makes the whole row a target people click with nothing
            // happening — and the value that identifies the record is what they aim at.
            if (isset($row[0]) && $row[0] !== null && $row[0] !== '') {
                $row[0] = '<a href="' . $showUrl . '">'
                    . htmlspecialchars((string) $row[0], ENT_QUOTES, 'UTF-8') . '</a>';
            }

            // Icons, not words: the actions are identical on every row, so after the
            // first row the words carry no information and cost most of the width.
            // Each one is labelled — `Html\Icon::link()` emits `title` and
            // `aria-label` — because an icon-only control with neither is a control
            // only its author can use.
            $row[] = \Pramnos\Html\Icon::link($showUrl, 'view', 'View this record')
                   . \Pramnos\Html\Icon::link(sURL . '{{ className }}/edit/' . $id, 'edit', 'Edit this record')
                   . \Pramnos\Html\Icon::link(
                       sURL . '{{ className }}/delete/' . $id,
                       'delete',
                       'Delete this record',
                       ['data-confirm' => 'Are you sure?', 'class' => 'pf-action-danger']
                   );
            unset($row['DT_RowId']);
        }
        unset($row);

        echo json_encode($result);
        $this->terminate();
    }
