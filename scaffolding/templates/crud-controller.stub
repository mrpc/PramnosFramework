    public function display(): string
    {
        $dt = new \Pramnos\Html\Datatable('dt-{{ viewName }}');
        $dt->source = sURL . '{{ className }}/data';
        $dt->bootstrap = {{ bootstrapFlag }};
        // A search box under each column, on top of the global one. They wait for
        // Datatable::$minSearchLength characters and debounce, so a filter is not one
        // query per keystroke across the whole table.
        $dt->footerTextSearch = true;
        $dt->{{ datatableColumns }};

        $view = $this->getView('{{ viewName }}');
        $view->datatable = $dt;
        $doc = \Pramnos\Framework\Factory::getDocument();
        $doc->title = '{{ className }}';
        $this->application->addbreadcrumb('{{ className }}', sURL . '{{ className }}');
        return $view->display();
    }

    /**
     * Display the specified resource
     */
    public function show(): string
    {
        $view    = $this->getView('{{ viewName }}');
        $request = new \Pramnos\Http\Request();
        // `load()` is used as an expression, not a statement, and that is not style.
        // A model that scopes itself to a tenant refuses a row belonging to somebody else
        // by returning a *different* instance; `$this` has already been populated by then,
        // so a caller that discards the return value inspects the row that was refused and
        // serves it. Take the answer from the return value and the refusal holds.
        $model   = (new \{{ modelNameSpace }}\{{ modelClass }}($this))->load($request->getOption());
        $view->addModel($model);
        $doc = \Pramnos\Framework\Factory::getDocument();
        $doc->title = $model->{{ firstNonPkField }} . ' | {{ className }}';
        $this->application->addbreadcrumb('{{ className }}', sURL . '{{ className }}');
        $this->application->addbreadcrumb((string)$model->{{ firstNonPkField }}, sURL . '{{ className }}/show/' . $model->{{ primaryKey }});
        return $view->display('show');
    }

