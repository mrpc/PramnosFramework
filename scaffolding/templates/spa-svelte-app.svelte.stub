<script>
    /**
     * Root component of the {{ appName }} SPA.
     *
     * It mirrors the structure of the server-rendered theme — header with the
     * application name and navigation, content, footer — so the two halves of a
     * hybrid project do not look like two different products.
     *
     * Every screen has a real URL (see lib/router.js) and access is decided in
     * one place: an anonymous visitor is sent to the sign-in screen, a signed-in
     * visitor who is not allowed somewhere is sent home. Showing "you do not
     * have permission" to someone who simply has not signed in yet is a dead end.
     */
    import { api, ApiError, login, logout, currentUser } from './lib/api.js';
    import { reportError } from './lib/debug.js';
    import { start as startRouter, go, href } from './lib/router.js';
    import { screens } from './screens/registry.js';
    import Omnibox from './components/Omnibox.svelte';

    const hasAuth = Boolean(window.__PRAMNOS__?.features?.auth);
    const appName = window.__PRAMNOS__?.appName ?? '{{ appName }}';

    /**
     * The current route — an object, not a name.
     *
     * `parse()` carries `segments` and `query` as well as `name`, and this is
     * passed down to every screen as a prop. That is what lets a screen keep
     * its page, its search, its sort and the record being edited in the URL
     * instead of in component state: a background re-read then leaves the user
     * where they were, and "page 3 of the stations, sorted by listeners" is a
     * link somebody can send.
     */
    let route   = $state({ name: 'home', path: '/', segments: [], query: new URLSearchParams() });
    let status  = $state(null);
    let error   = $state(null);
    let loading = $state(true);

    let user      = $state(null);
    let userReady = $state(!hasAuth);
    let username  = $state('');
    let password  = $state('');
    let signingIn = $state(false);
    let authError = $state(null);

    /** Screens that require a signed-in user. */
    const PROTECTED = ['admin', ...screens.map((s) => s.name)];

    /** The screen component for the current route, if it is one. */
    const screen = $derived(screens.find((s) => s.name === route.name) ?? null);

    $effect(() => {
        api.get('{{ probeEndpoint }}')
            .then((payload) => { status = payload; })
            .catch((err) => {
                error = err instanceof ApiError
                    ? `API answered ${err.status}`
                    : 'Could not reach the API';
            })
            .finally(() => { loading = false; });

        if (hasAuth) {
            // Someone signed in through the server-rendered pages is already
            // authenticated here — the API accepts the session cookie.
            currentUser()
                .then((found) => { user = found; })
                .catch(() => {})
                .finally(() => { userReady = true; });
        }

        startRouter((next) => { route = next; });
    });

    // Access control in one place, applied whenever the route or the user
    // changes. Waiting for userReady matters: deciding before we know who the
    // visitor is would bounce a signed-in user to the login screen on reload.
    $effect(() => {
        if (!hasAuth || !userReady) {
            return;
        }
        if (!user && PROTECTED.includes(route.name)) {
            go('/signin', null, { replace: true });
        }
        if (user && route.name === 'signin') {
            go('/', null, { replace: true });
        }
    });

    /** Sign in with the credentials in the form. */
    async function submitLogin(event) {
        event.preventDefault();
        authError = null;
        signingIn = true;
        try {
            user     = await login(username, password);
            password = '';
            go('/', null, { replace: true });
        } catch (err) {
            authError = err instanceof ApiError && err.status === 401
                ? 'Wrong username or password.'
                : 'Could not sign in.';
        } finally {
            signingIn = false;
        }
    }

    /** Revoke the token and return to the front page. */
    async function submitLogout() {
        await logout();
        user = null;
        go('/', null, { replace: true });
    }
</script>

<div class="flex min-h-screen flex-col bg-base-200">
    <header class="navbar bg-base-100 shadow-sm">
        <div class="container mx-auto flex items-center gap-2">
            <a class="btn btn-ghost text-xl" href={href('/')}>
                {appName}
            </a>

            <nav class="flex items-center gap-1">
                <!-- The admin screen has its own entry below, shown only to a
                     signed-in user, so it is filtered out of the general list. -->
                {#each screens.filter((s) => !s.admin) as item}
                    <a
                        class="btn btn-ghost btn-sm"
                        class:btn-active={route.name === item.name}
                        href={href('/' + item.name)}
                    >{item.label}</a>
                {/each}

                {#if hasAuth && user && screens.some((s) => s.admin)}
                    <a
                        class="btn btn-ghost btn-sm"
                        class:btn-active={route.name === 'admin'}
                        href={href('/admin')}
                    >Admin</a>
                {/if}
            </nav>

            <div class="ml-auto flex items-center gap-3">
                {#if hasAuth && user && screens.some((s) => s.admin)}
                    <!-- Cross-entity search. Rendered only for a signed-in user who can
                         reach the admin screen: the endpoint is permission-checked, so a
                         box that always 403s is worse than no box. -->
                    <Omnibox />
                {/if}
                {#if hasAuth && user}
                    <span class="text-sm opacity-70">{user.username ?? user.email}</span>
                    <button class="btn btn-sm" onclick={submitLogout}>Sign out</button>
                {:else if hasAuth}
                    <a class="btn btn-primary btn-sm" href={href('/signin')}>
                        Sign in
                    </a>
                {/if}
            </div>
        </div>
    </header>

    <main class="container mx-auto flex-1 p-6">
        {#if route.name === 'signin'}
            <div class="card mx-auto w-full max-w-sm bg-base-100 shadow">
                <div class="card-body">
                    <h2 class="card-title">Sign in</h2>
                    <form class="flex flex-col gap-3" onsubmit={submitLogin}>
                        <label class="form-control">
                            <span class="label-text">Username</span>
                            <input class="input input-bordered" bind:value={username} autocomplete="username" required />
                        </label>
                        <label class="form-control">
                            <span class="label-text">Password</span>
                            <input class="input input-bordered" type="password" bind:value={password} autocomplete="current-password" required />
                        </label>

                        {#if authError}
                            <div role="alert" class="alert alert-error"><span>{authError}</span></div>
                        {/if}

                        <button class="btn btn-primary" type="submit" disabled={signingIn}>
                            {signingIn ? 'Signing in…' : 'Sign in'}
                        </button>
                    </form>
                </div>
            </div>
        {:else if screen}
            {@const Screen = screen.component}
            <!--
                A screen that throws while rendering takes the whole application
                down with it in Svelte 5 unless a boundary catches it. The
                boundary keeps the shell — header, navigation, a way out — and
                hands the failure to the debug panel's Errors tab, where it sits
                next to the request the screen was reacting to. In production
                reportError is inert.
            -->
            <svelte:boundary onerror={(err) => reportError(err, { kind: 'component' })}>
                <!-- Every screen receives the route. Its page, search, sort
                     and the record being edited come from there rather than
                     from component state, so the URL is the state and a link
                     to it is a link to what the user is looking at. -->
                <Screen {route} />

                {#snippet failed(err, reset)}
                    <div role="alert" class="alert alert-error flex-col items-start gap-2">
                        <span>This screen failed to render: {err?.message ?? 'unknown error'}</span>
                        <button class="btn btn-sm" onclick={reset}>Try again</button>
                    </div>
                {/snippet}
            </svelte:boundary>
        {:else}
            <div class="grid gap-6 md:grid-cols-2">
                <div class="card bg-base-100 shadow">
                    <div class="card-body">
                        <h2 class="card-title">Backend</h2>

                        {#if loading}
                            <span class="loading loading-spinner loading-md"></span>
                        {:else if error}
                            <div role="alert" class="alert alert-error"><span>{error}</span></div>
                        {:else}
                            <div role="alert" class="alert alert-success">
                                <span>Connected to the API.</span>
                            </div>
                            <pre class="mt-2 overflow-x-auto rounded bg-base-200 p-3 text-sm">{JSON.stringify(status, null, 2)}</pre>
                            <p class="mt-2 text-sm opacity-70">
                                Served by <code>src/Services/StatusService.php</code> through
                                <code>src/Api/Controllers/Status.php</code>.
                            </p>
                        {/if}
                    </div>
                </div>

                <div class="card bg-base-100 shadow">
                    <div class="card-body">
                        <h2 class="card-title">Getting started</h2>
                        <ul class="list-inside list-disc text-sm opacity-80">
                            <li>Edit this screen in <code>frontend/App.svelte</code>.</li>
                            <li>Add a feature with <code>./{{ cliName }} create:crud &lt;name&gt;</code> — it
                                generates the API endpoints and a screen, and the screen appears
                                in the navigation by itself.</li>
                            <li>Front-end tests: <code>./testjs</code>. How to write them:
                                <code>docs/FRONTEND_TESTING.md</code>.</li>
                        </ul>
                    </div>
                </div>
            </div>
        {/if}
    </main>

    <footer class="footer footer-center bg-base-100 p-4 text-sm">
        <p>© {new Date().getFullYear()} {appName}. All rights reserved.</p>
    </footer>
</div>
