<script>
    /**
     * Root component of the {{ appName }} SPA.
     *
     * Two things a scaffold should prove on first load: that the front end
     * reaches the JSON API, and — when the auth feature is enabled — that
     * signing in works end to end. Both are here, wired to real endpoints, so
     * the first screen is a working example rather than a placeholder.
     *
     * Svelte 5 runes ($state / $derived / $effect) and daisyUI classes.
     */
    import { api, ApiError, login, logout, currentUser } from './lib/api.js';
    import { screens } from './screens/registry.js';

    const hasAuth = Boolean(window.__PRAMNOS__?.features?.auth);

    let status  = $state(null);
    let error   = $state(null);
    let loading = $state(true);

    // Which generated screen is showing (null = the overview below).
    let screen   = $state(null);

    let user     = $state(null);
    let username = $state('');
    let password = $state('');
    let signingIn = $state(false);
    let authError = $state(null);

    $effect(() => {
        api.get('{{ probeEndpoint }}')
            .then((payload) => { status = payload; })
            .catch((err) => {
                error = err instanceof ApiError
                    ? `API answered ${err.status}`
                    : 'Could not reach the API';
            })
            .finally(() => { loading = false; });

        if (hasAuth) {
            // Anyone already signed in through the server-rendered pages is
            // authenticated here too — the API accepts the session cookie.
            currentUser().then((found) => { user = found; }).catch(() => {});
        }
    });

    /** Sign in with the credentials in the form. */
    async function submitLogin(event) {
        event.preventDefault();
        authError = null;
        signingIn = true;
        try {
            user     = await login(username, password);
            password = '';
        } catch (err) {
            authError = err instanceof ApiError && err.status === 401
                ? 'Wrong username or password.'
                : 'Could not sign in.';
        } finally {
            signingIn = false;
        }
    }

    /** Revoke the token and go back to the signed-out state. */
    async function submitLogout() {
        await logout();
        user = null;
    }
</script>

<div class="min-h-screen bg-base-200">
    <div class="navbar bg-base-100 shadow-sm">
        <a class="btn btn-ghost text-xl" href="/">{{ appName }}</a>
        {#each screens as item}
            <button
                class="btn btn-ghost btn-sm"
                class:btn-active={screen?.name === item.name}
                onclick={() => (screen = screen?.name === item.name ? null : item)}
            >{item.label}</button>
        {/each}

        {#if hasAuth && user}
            <div class="ml-auto flex items-center gap-3">
                <span class="text-sm opacity-70">{user.username ?? user.email}</span>
                <button class="btn btn-sm" onclick={submitLogout}>Sign out</button>
            </div>
        {/if}
    </div>

    {#if screen}
        <!-- A screen generated by `create:crud` — see frontend/screens/.
             Bound to a local so it renders as a normal component: in runes mode
             components are dynamic already and <svelte:component> is deprecated. -->
        {@const Screen = screen.component}
        <main class="p-6">
            <Screen />
        </main>
    {:else}
    <main class="grid gap-6 p-6 md:grid-cols-2">
        <div class="card bg-base-100 shadow">
            <div class="card-body">
                <h2 class="card-title">Backend</h2>

                {#if loading}
                    <span class="loading loading-spinner loading-md"></span>
                {:else if error}
                    <div role="alert" class="alert alert-error">
                        <span>{error}</span>
                    </div>
                {:else}
                    <div role="alert" class="alert alert-success">
                        <span>Connected to the API.</span>
                    </div>
                    <pre class="mt-2 overflow-x-auto rounded bg-base-200 p-3 text-sm">{JSON.stringify(status, null, 2)}</pre>
                    <p class="mt-2 text-sm opacity-70">
                        Served by <code>src/Services/StatusService.php</code> through
                        <code>src/Api/Controllers/Status.php</code>.
                    </p>
                {/if}
            </div>
        </div>

        {#if hasAuth}
            <div class="card bg-base-100 shadow">
                <div class="card-body">
                    <h2 class="card-title">Account</h2>

                    {#if user}
                        <div role="alert" class="alert alert-success">
                            <span>Signed in as {user.username ?? user.email}.</span>
                        </div>
                        <pre class="mt-2 overflow-x-auto rounded bg-base-200 p-3 text-sm">{JSON.stringify(user, null, 2)}</pre>
                    {:else}
                        <form class="flex flex-col gap-3" onsubmit={submitLogin}>
                            <label class="form-control">
                                <span class="label-text">Username</span>
                                <input class="input input-bordered" bind:value={username} autocomplete="username" required />
                            </label>
                            <label class="form-control">
                                <span class="label-text">Password</span>
                                <input class="input input-bordered" type="password" bind:value={password} autocomplete="current-password" required />
                            </label>

                            {#if authError}
                                <div role="alert" class="alert alert-error"><span>{authError}</span></div>
                            {/if}

                            <button class="btn btn-primary" type="submit" disabled={signingIn}>
                                {signingIn ? 'Signing in…' : 'Sign in'}
                            </button>
                        </form>
                        <p class="text-sm opacity-70">
                            Posts to <code>{{ apiPrefix }}/account/login</code>; the issued token is
                            reused by every later request.
                        </p>
                    {/if}
                </div>
            </div>
        {/if}
    </main>
    {/if}
</div>
