#
# MySQL configuration for the test container.
#
# This database exists to be dropped. `dockertest --resetdb` drops and recreates it,
# every integration test creates its own tables, and nothing here outlives a run — so
# paying for crash durability buys nothing and costs a great deal. Measured, in this
# container, against the framework's own workload:
#
#                             before    after
#   5 INSERTs                 77.0ms    3.8ms     (a double fsync per commit)
#   2 DROP + 2 CREATE TABLE  279.6ms  136.9ms
#   transaction + ROLLBACK     7.5ms    0.6ms
#
# The MySQL integration classes were 5–6× slower per test than the PostgreSQL classes
# running the same assertions, which is what pointed here: PostgreSQL was not faster at
# SQL, it was configured less durably.
#
# Never copy this file to anything that holds data you would miss.
#
[mysqld]

# Do not fsync the redo log on commit. A crash can lose the last second of
# transactions; the alternative is an fsync per INSERT, and the tests write a lot of
# single rows.
innodb_flush_log_at_trx_commit = 0

# No binary log at all. Nothing replicates from this server and nothing recovers to a
# point in time, so the binlog is a second fsync per commit for no reader.
skip-log-bin

# Belt-and-braces: with the binlog off, sync_binlog has nothing to sync. Set anyway so
# the intent survives somebody re-enabling the binlog for a debugging session.
sync_binlog = 0

# The doublewrite buffer protects against torn pages during a crash. Same reasoning:
# a torn page here is fixed by recreating the database.
innodb_doublewrite = OFF
