#!/usr/bin/env php
<?php declare(strict_types=1);

if (PHP_VERSION_ID < 80100) {
    echo "Pramnos Framework requires PHP 8.1.0 or greater. You are running PHP " . PHP_VERSION . ".\n";
    exit(1);
}

$possibleAutoloadPaths = [
     // Composer's own bin-proxy hint — always points at the *consuming*
     // project's autoloader, even when this package is installed as a
     // symlinked path repository (where __DIR__ resolves to the real
     // framework directory and the relative guesses below all miss).
     $GLOBALS['_composer_autoload_path'] ?? null,
     // dependency
     __DIR__ . '/../../../autoload.php',
     // local dev repository
     __DIR__ . '/../vendor/autoload.php',
];

$autoloadLoaded = false;
foreach ($possibleAutoloadPaths as $possibleAutoloadPath) {
    if ($possibleAutoloadPath !== null && file_exists($possibleAutoloadPath)) {
        require_once $possibleAutoloadPath;
        $autoloadLoaded = true;
        break;
    }
}

if (!$autoloadLoaded) {
    fwrite(STDERR, "Pramnos: could not locate a Composer autoloader. "
        . "Run 'composer install' (or 'composer dump-autoload') first.\n");
    exit(1);
}

if (!defined('ROOT')) {
    $cwd = getcwd();
    // Path if we are in a project that has us as a dependency (handles symlinks)
    $projectVendorPath = $cwd . DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR . 'mrpc' . DIRECTORY_SEPARATOR . 'pramnosframework';
    
    if (file_exists($projectVendorPath)) {
        define('ROOT', $cwd);
    } elseif (strpos(__FILE__, DIRECTORY_SEPARATOR . 'vendor' . DIRECTORY_SEPARATOR) !== false) {
        // Standard installation (non-symlinked vendor)
        define('ROOT', dirname(__DIR__, 4));
    } else {
        // Local framework development repository
        define('ROOT', dirname(__DIR__));
    }
}



$app = new \Pramnos\Console\Application();
$app->run();
