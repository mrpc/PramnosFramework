#!/usr/bin/env bash

# Prevent concurrent test runs: they share the same MySQL/PostgreSQL Docker
# databases, so two overlapping runs will stomp each other's tables and produce
# spurious failures.
#
# Lock strategy: a portable mkdir-based lock (see below). mkdir is atomic on
# Linux, macOS and WSL alike — unlike flock, which is Linux-only and made every
# macOS run falsely report "already in progress". The lock is released via an
# EXIT trap; if a run is hard-killed before the trap fires, the next run detects
# the stale PID (recorded in the lock dir) and clears it automatically.
nobrowser=false
coverage=false
nocoverage=false
testdox=false
resetdb=false
force=false
passthrough=()
for arg in "$@"; do
    if [[ "$arg" == "--nobrowser" ]]; then
        nobrowser=true
    elif [[ "$arg" == "--coverage" ]]; then
        coverage=true
    elif [[ "$arg" == "--nocoverage" || "$arg" == "--no-coverage" ]]; then
        # Fully disable coverage collection for this run. phpunit.xml always
        # declares a <coverage> block, so PHPUnit otherwise instruments every
        # line via Xdebug on EVERY run (slow). This flag overrides that and
        # turns Xdebug off entirely, for the fastest possible run.
        nocoverage=true
    elif [[ "$arg" == "--testdox" ]]; then
        testdox=true
    elif [[ "$arg" == "--reset-db" ]]; then
        resetdb=true
    elif [[ "$arg" == "--force" ]]; then
        force=true
    else
        passthrough+=("$arg")
    fi
done

# Concurrency lock. The previous implementation used flock, which is Linux-only
# and absent on macOS (there `flock: command not found` made every run think one
# was already in progress). We use a portable mkdir-based lock instead: mkdir is
# atomic on every platform — it succeeds only if the directory does not already
# exist. A PID file inside the lock dir lets a later run detect a stale lock left
# behind by a hard-killed process.
LOCK_DIR="/tmp/dockertest-pramnos.lock.d"
LOCK_PID_FILE="$LOCK_DIR/pid"

_lock_pid()     { cat "$LOCK_PID_FILE" 2>/dev/null; }
_release_lock() { rm -rf "$LOCK_DIR"; }
_acquire_lock() {
    if mkdir "$LOCK_DIR" 2>/dev/null; then
        echo $$ >"$LOCK_PID_FILE"
        return 0
    fi
    return 1
}

if [[ "$force" == true ]]; then
    existing_pid=$(_lock_pid)
    if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
        echo "Killing existing dockertest process (PID: $existing_pid) due to --force..." >&2
        kill -9 "$existing_pid" 2>/dev/null
    fi
    _release_lock
fi

if ! _acquire_lock; then
    existing_pid=$(_lock_pid)
    # Stale lock: the recorded process is no longer running (e.g. hard-killed
    # before its EXIT trap could clean up).
    if [[ -z "$existing_pid" ]] || ! kill -0 "$existing_pid" 2>/dev/null; then
        echo "Stale lock detected (PID ${existing_pid:-unknown} is gone). Clearing and proceeding." >&2
        _release_lock
        _acquire_lock || { echo "Could not acquire lock after clearing stale entry." >&2; exit 1; }
    else
        echo "Another ./dockertest run is already in progress (PID: ${existing_pid})." >&2
        echo "  To kill it:  kill $existing_pid  or run with --force" >&2
        exit 1
    fi
fi

# Release the lock on any exit (normal, error, or Ctrl-C). A hard SIGKILL won't
# run this — that case is handled by the stale-PID check above on the next run.
trap '_release_lock' EXIT

# Portable `timeout`. The daemon-hang guards below rely on GNU coreutils
# `timeout`, which is absent on macOS by default (there was no `timeout` and no
# `gtimeout`). Prefer a real one when present; otherwise fall back to a bash
# implementation that mirrors the two call forms used here — `timeout DURATION
# cmd…` and `timeout -k KILL_AFTER DURATION cmd…` — and, like GNU timeout,
# returns 124 when the command is killed for exceeding its deadline (the callers
# test for 124 to detect a wedged daemon).
_bash_timeout() {
    local kill_after=""
    if [[ "$1" == "-k" ]]; then kill_after="$2"; shift 2; fi
    local duration="${1%[sS]}"; shift

    # The timer touches this marker the moment the deadline is reached — a
    # reliable "did we time out?" signal that survives the -k kill-after window
    # (during which the timer is still alive, so a liveness check misclassifies).
    local marker
    marker="$(mktemp 2>/dev/null || echo "/tmp/dockertest-timeout.$$.$RANDOM")"
    rm -f "$marker"

    ( "$@" ) &
    local cmd_pid=$!

    (
        sleep "$duration"
        : >"$marker"
        kill -TERM "$cmd_pid" 2>/dev/null
        if [[ -n "$kill_after" ]]; then
            sleep "$kill_after"
            kill -KILL "$cmd_pid" 2>/dev/null
        fi
    ) 2>/dev/null &
    local timer_pid=$!

    wait "$cmd_pid" 2>/dev/null
    local rc=$?

    # Command has exited (on its own, or via the timer's TERM/KILL). Stop the
    # timer and, if it had reached the deadline, report GNU timeout's 124.
    kill -TERM "$timer_pid" 2>/dev/null
    wait "$timer_pid" 2>/dev/null
    [[ -e "$marker" ]] && rc=124
    rm -f "$marker"
    return $rc
}

if ! command -v timeout >/dev/null 2>&1; then
    if command -v gtimeout >/dev/null 2>&1; then
        timeout() { gtimeout "$@"; }
    else
        timeout() { _bash_timeout "$@"; }
    fi
fi

# Docker can hang indefinitely when the daemon is wedged — a common WSL / Docker
# Desktop failure mode. Every docker *control* call below is bounded by a timeout
# so a stuck daemon fails fast with a clear message instead of an endless, silent
# hang. The actual test run further down is deliberately NOT time-limited.
DOCKER_CTL_TIMEOUT="${DOCKERTEST_DOCKER_TIMEOUT:-45}"

_die_docker_wedged() {
    echo "" >&2
    echo "ERROR: Docker did not respond within ${DOCKER_CTL_TIMEOUT}s while running: $1" >&2
    echo "The Docker daemon appears to be wedged (common on WSL / Docker Desktop)." >&2
    echo "Try restarting Docker Desktop, or run 'wsl.exe --shutdown' from PowerShell, then retry." >&2
    _release_lock
    exit 1
}

# Wait until the php container can actually run a command. A freshly started
# container (especially under WSL / Docker Desktop) does not accept 'exec' for
# several seconds after 'up -d'; the very first exec then blocks indefinitely —
# which a blind 'sleep' cannot reliably cover. Each attempt is hard-bounded with
# 'timeout -k' so a stuck exec is SIGKILLed and retried, never hung. Returns
# non-zero only if the container never becomes ready within the deadline.
# NOTE on '< /dev/null': 'docker-compose exec' attaches the caller's stdin to
# the remote process even with '-T'. When invoked from an interactive terminal
# (e.g. Windows Terminal -> WSL) that stdin is a TTY, and the exec blocks on the
# TTY attach — hanging forever. Redirecting stdin from /dev/null gives an
# immediate EOF so the exec returns cleanly. This is why the script hangs in an
# interactive shell but not when driven non-interactively (pipe/CI).
_wait_php_ready() {
    local deadline=$((SECONDS + 60))
    while (( SECONDS < deadline )); do
        if timeout -k 3 10 docker-compose exec -T php-apache-environment true </dev/null >/dev/null 2>&1; then
            return 0
        fi
        sleep 1
    done
    return 1
}

# Preflight: fail fast if the daemon is unresponsive or not running.
if ! timeout 15 docker version >/dev/null 2>&1; then
    echo "" >&2
    echo "ERROR: Docker is not responding (timed out after 15s, or the daemon is not running)." >&2
    echo "Start Docker Desktop / the daemon (on WSL you may need 'wsl.exe --shutdown' then reopen) and retry." >&2
    _release_lock
    exit 1
fi

# Check if containers are running. Capture ps output separately so a timeout is
# distinguishable from "containers down" (piping to grep would hide the 124).
ps_out=$(timeout -k 5 "$DOCKER_CTL_TIMEOUT" docker-compose ps 2>/dev/null)
[[ $? -eq 124 ]] && _die_docker_wedged "docker-compose ps"
if ! grep -q "pramnos_php.*Up" <<<"$ps_out"; then
    echo "Containers not running. Starting them..."
    # Plain 'up -d' starts existing images and is normally quick; allow extra
    # headroom in case a first-time image build is triggered.
    if ! timeout -k 10 300 docker-compose up -d; then
        rc=$?
        [[ $rc -eq 124 ]] && _die_docker_wedged "docker-compose up -d"
        echo "ERROR: 'docker-compose up -d' failed (exit $rc)." >&2
        _release_lock
        exit 1
    fi
    echo "Waiting for services to be ready..."
    if ! _wait_php_ready; then
        _die_docker_wedged "waiting for the php container to accept 'exec' after 'up -d'"
    fi
fi

# The MySQL container carries durability settings appropriate to a database that
# exists to be dropped (docker/mysql/my.cnf) — worth 126 s of a 15-minute suite,
# measured. A container built before those settings existed still runs, still
# passes, and is silently two minutes slower, which is exactly the kind of thing
# nobody notices. So: say it, once, and say what to do about it.
#
# Best-effort and never fatal: this is an optimisation, not a requirement, and a
# db container that is not answering yet is the resetdb block's problem, not ours.
flush_setting=$(timeout -k 3 15 docker-compose exec -T db \
    mysql -uroot -psecret -N -B \
    -e "SHOW VARIABLES LIKE 'innodb_flush_log_at_trx_commit'" 2>/dev/null \
    | awk '{print $2}')
if [[ -n "$flush_setting" && "$flush_setting" != "0" ]]; then
    echo "NOTE: the MySQL container is running with full crash durability," >&2
    echo "      which makes the integration tests about 126s slower. Rebuild it:" >&2
    echo "        docker-compose build db && docker-compose up -d db" >&2
fi

# Optionally reset test databases to a clean slate (drops all accumulated tables
# from previous runs, then recreates empty databases).
if [[ "$resetdb" == true ]]; then
    echo "Resetting test databases..."
    docker-compose exec db mysql -uroot -psecret \
        -e "DROP DATABASE IF EXISTS pramnos_test; CREATE DATABASE pramnos_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" 2>/dev/null \
        && echo "  MySQL pramnos_test reset OK" || echo "  MySQL reset skipped (container not ready)"
    docker-compose exec timescaledb psql -U postgres \
        -c "DROP DATABASE IF EXISTS pramnos_test;" \
        -c "CREATE DATABASE pramnos_test;" \
        && echo "  PostgreSQL pramnos_test reset OK" || echo "  PostgreSQL reset skipped (container not ready)"
fi

# Warm up Apache / trigger the app so the first real request isn't cold.
# Hard-bounded on every axis: --connect-timeout guards a port proxy that
# accepts the TCP connection but never answers (a common WSL / Docker Desktop
# state right after 'up -d'), --max-time caps the whole request, and an outer
# 'timeout' is a belt-and-suspenders backstop in case curl itself misbehaves.
# The warmup is best-effort: a failure here must never block the test run.
echo "Making sure apache is active..."
timeout 15 curl -s -o /dev/null --connect-timeout 3 --max-time 10 http://localhost:18081/ 2>/dev/null
echo "  apache warmup done (rc=$?)"

# Ensure dependencies are installed. 'docker-compose exec' is the call most prone
# to freezing on a wedged daemon (see header note), so bound it and treat a
# timeout as fatal rather than falling through to a composer install that would
# hang too. Use -T so no TTY is expected under the timeout wrapper.
echo "Checking dependencies..."
# Guarantee the container is actually ready (cheap ~90ms when it already is);
# this is what prevents the first exec from hanging on a fresh 'up -d'.
_wait_php_ready || _die_docker_wedged "php container not ready for dependency check"
timeout -k 5 "$DOCKER_CTL_TIMEOUT" docker-compose exec -T php-apache-environment test -f vendor/bin/phpunit </dev/null
dep_rc=$?
[[ $dep_rc -eq 124 ]] && _die_docker_wedged "docker-compose exec (dependency check)"
if [[ $dep_rc -ne 0 ]]; then
    echo "Installing composer dependencies..."
    docker-compose exec -T php-apache-environment composer install </dev/null
fi

# Run tests
echo -e "\e[32mRunning PHPUnit tests...\e[0m"
extra_flags="--configuration phpunit.xml --display-deprecations --display-warnings --display-incomplete --display-skipped --display-phpunit-deprecations"
[[ "$testdox" == true ]] && extra_flags="$extra_flags --testdox"

# `set -e` is not in force here, so the exit status is captured explicitly and
# re-raised at the very end. Without it the script's status was that of whatever
# ran last — the coverage-report `if` — so a run that printed "FAILURES!" exited
# 0, and anything reading $? (CI, a pre-push hook, an agent) was told the suite
# passed. Observed on a real red run.
phpunit_status=0

if [[ "$coverage" == true ]]; then
    docker-compose exec php-apache-environment php -d memory_limit=1G vendor/bin/phpunit \
        --coverage-html coverage \
        --coverage-clover coverage/clover.xml \
        $extra_flags "${passthrough[@]}"
    phpunit_status=$?
elif [[ "$nocoverage" == true ]]; then
    # --no-coverage overrides the always-on <coverage> block in phpunit.xml;
    # XDEBUG_MODE=off removes the per-line instrumentation overhead completely.
    docker-compose exec -e XDEBUG_MODE=off php-apache-environment php -d memory_limit=1G vendor/bin/phpunit --no-coverage $extra_flags "${passthrough[@]}"
    phpunit_status=$?
else
    docker-compose exec php-apache-environment php -d memory_limit=1G vendor/bin/phpunit $extra_flags "${passthrough[@]}"
    phpunit_status=$?
fi

# Open coverage report if generated and not suppressed
if [[ "$coverage" == true && "$nobrowser" == false && -f ./coverage/index.html ]]; then
    if [[ "$OSTYPE" == "msys" || "$OSTYPE" == "cygwin" || "$OSTYPE" == "linux-gnu"* && "$(uname -r)" == *"Microsoft"* || -n "$WSL_DISTRO_NAME" ]]; then
        win_path=$(wslpath -w "$(pwd)")
        explorer.exe "$win_path\coverage\index.html"
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        xdg-open ./coverage/index.html
    elif [[ "$OSTYPE" == "darwin"* ]]; then
        open ./coverage/index.html
    fi
fi

# The result of the run, not of the last thing the script happened to do.
exit $phpunit_status
